// lib/agrix/module5/engines/microsoft.gateway.ts

import { MicrosoftGatewayOutput, MicrosoftRequest } from '../types/microsoft-gateway.types';
import { Module1Output } from '../../module1/orchestrate/full';
import { Module2Output } from '../../module2/orchestrate/full';
import { Module3Output } from '../../module3/orchestrate/full';

/**
 * マイクロソフトAzure連携Gateway
 * Azureサービス向け標準化データを生成
 */
export function generateMicrosoftGateway(
  module1: Module1Output,
  module2: Module2Output,
  module3: Module3Output,
  request: MicrosoftRequest
): MicrosoftGatewayOutput {
  const { tenantId, farmId, eventType, includeDataLake, includeAPIManagement } = request;

  // --- Event Hub ペイロード ---
  const eventData: Record<string, any> = {
    farmId,
    tenantId,
    timestamp: new Date().toISOString(),
    module1: {
      agrixHealthScore: module1.agrixHealthScore,
      hypercycle: module1.hypercycle,
      biosecurity: module1.biosecurity,
      biocontrol: module1.biocontrol
    },
    module2: {
      mscIntegratedScore: module2.mscIntegratedScore,
      humus: module2.humus,
      fertilizer: module2.fertilizer,
      feed: module2.feed,
      economicValue: module2.economicValue
    },
    module3: {
      soc: module3.soc,
      sequestration: module3.sequestration,
      methane: module3.methane,
      ghgAccounting: module3.ghgAccounting,
      gatesSummary: module3.gatesSummary
    }
  };

  // イベントタイプ別にデータを絞り込み
  let filteredData = eventData;
  if (eventType === 'SOIL_DATA') {
    filteredData = { farmId, tenantId, soilData: eventData.module1, timestamp: eventData.timestamp };
  } else if (eventType === 'AGENT_OUTPUT') {
    filteredData = { farmId, tenantId, agents: eventData.module1, timestamp: eventData.timestamp };
  } else if (eventType === 'CERTIFICATE') {
    filteredData = { farmId, tenantId, certificate: eventData.module3, timestamp: eventData.timestamp };
  } else if (eventType === 'PRICING') {
    filteredData = { farmId, tenantId, pricing: eventData.module2.economicValue, timestamp: eventData.timestamp };
  }

  const eventHubPayload = {
    eventType,
    source: `/farms/${farmId}`,
    specVersion: '1.0',
    data: filteredData,
    time: new Date().toISOString(),
    datacontenttype: 'application/json' as const,
    subject: `AGRIX-${eventType}`,
    id: `${farmId}-${eventType}-${Date.now()}`
  };

  // --- Data Lake 用データ ---
  const dataLakeMetrics = [
    { name: 'agrix_health_score', value: module1.agrixHealthScore, unit: 'score', timestamp: new Date().toISOString() },
    { name: 'cycle_efficiency', value: module1.hypercycle.cycleEfficiency, unit: 'ratio', timestamp: new Date().toISOString() },
    { name: 'soc_percent', value: module3.soc.current.soc_percent, unit: 'percent', timestamp: new Date().toISOString() },
    { name: 'carbon_sequestration', value: module3.sequestration.stableCarbon.annualSequestration_tCO2, unit: 'tCO2_ha', timestamp: new Date().toISOString() },
    { name: 'ghg_reduction', value: module3.ghgAccounting.reduction.totalReduction, unit: 'tCO2e', timestamp: new Date().toISOString() },
    { name: 'msc_score', value: module2.mscIntegratedScore, unit: 'score', timestamp: new Date().toISOString() },
  ];

  const dataLakeData = {
    partitionKey: farmId,
    timestamp: new Date().toISOString(),
    farmId,
    metrics: dataLakeMetrics,
    tags: {
      cropType: 'CORN',
      region: 'GLOBAL',
      tenantId
    },
    geoLocation: {
      latitude: 36.2048,
      longitude: 138.2529
    }
  };

  // --- API Management 仕様 ---
  const apiEndpoints = [
    {
      path: '/api/agrix/soil',
      method: 'POST' as const,
      description: '土壌データ登録',
      rateLimit: 60,
      authentication: 'ENTRA_ID' as const,
      scopes: ['agrix.soil.write']
    },
    {
      path: '/api/agrix/orchestrate',
      method: 'POST' as const,
      description: 'AGRIX全診断実行',
      rateLimit: 30,
      authentication: 'ENTRA_ID' as const,
      scopes: ['agrix.analyze']
    },
    {
      path: '/api/agrix/module3/gates-dashboard',
      method: 'GET' as const,
      description: 'ビル・ゲイツダッシュボードデータ',
      rateLimit: 10,
      authentication: 'ENTRA_ID' as const,
      scopes: ['agrix.gates.view']
    },
    {
      path: '/api/agrix/module5/safetychain',
      method: 'GET' as const,
      description: 'SafetyChain証明書取得',
      rateLimit: 100,
      authentication: 'API_KEY' as const,
      scopes: ['safetychain.read']
    },
    {
      path: '/api/agrix/module5/pbpe',
      method: 'GET' as const,
      description: 'PBPE資産評価取得',
      rateLimit: 50,
      authentication: 'ENTRA_ID' as const,
      scopes: ['pbpe.read']
    }
  ];

  return {
    eventHub: eventHubPayload,
    dataLake: includeDataLake ? dataLakeData : undefined,
    apiManagement: includeAPIManagement ? {
      endpoints: apiEndpoints,
      subscription: {
        tier: 'ENTERPRISE',
        quota: 10000,
        usage: 0,
        validUntil: new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString()
      }
    } : undefined,
    entraID: {
      tenantId,
      applicationId: 'AGRIX-APP-001',
      roles: ['Admin', 'DataAnalyst', 'Viewer'],
      permissions: ['read:soil', 'write:soil', 'read:certificate', 'write:certificate', 'read:pricing'],
      scopes: ['agrix.full', 'safetychain.read', 'pbpe.read']
    },
    version: '1.0.0',
    generatedAt: new Date().toISOString(),
    tenantId
  };
}

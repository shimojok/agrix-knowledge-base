# 🧱 **AGRIX Soil Schema（MVP）**

## ① Physical Layer（物理層）

ts

```
physical: {
  soilType: string,        // 砂質・ローム・粘土
  bulkDensity: number,     // g/cm3
  moisture: number,        // %
  temperature: number,     // °C
}
```

## ② Chemical Layer（化学層）

ts

```
chemical: {
  pH: number,
  ec: number,              // dS/m
  cnRatio: number,
  nutrients: {
    n: number,
    p: number,
    k: number,
    ca: number,
    mg: number,
    fe: number,
    mn: number,
    zn: number,
    cu: number,
  },
  contaminants: {
    esp: number,           // 交換性ナトリウム比
    cd: number,
    pb: number,
    as: number,
    pesticideResidue: boolean,
  }
}
```

## ③ Carbon & Humus Layer（炭素・腐植層）

ts

```
carbon: {
  soc: number,             // 有機炭素量
  som: number,             // 有機物量
  humus: {
    humicAcid: number,
    fulvicAcid: number,
    humin: number,
    humificationRate: number,
  }
}
```

## ④ Biological Layer（生物層）

ts

```
biological: {
  microbialBiomassC: number,
  microbialActivity: number,   // 呼吸量
  omDegradationRate: number,   // 有機物分解率
  diversityIndex: number,      // Shannon
  pathogens: number,           // 病原菌数
}
```

## ⑤ MBT55 Hypercycle Layer（MBT55専用）

ts

```
mbt55: {
  dosage: number,              // 投入量
  activityIndex: number,       // 温度・pH・ECから算出
  temperatureCurve: number[],  // 0h, 12h, 24h
  phCurve: number[],
  ecCurve: number[],
  degradation24h: number,      // 24h分解率
  cnShift: number,             // C/N変化量
  metabolitePotential: {
    aminoAcids: number,
    scfa: number,
    polyphenols: number,
  },
  ghgRisk: {
    methaneRisk: number,
    n2oRisk: number,
  }
}
```


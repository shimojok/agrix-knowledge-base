/* GATEWAY BANNER */
.gateway{background:linear-gradient(135deg,#0F1F0F,#1A1200,#0A1525);border:1px solid var(--border);border-radius:10px;padding:20px 24px;margin-bottom:18px;position:relative;overflow:hidden;}

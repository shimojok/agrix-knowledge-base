.gw-banner{background:linear-gradient(135deg,#0F1F0F,#1A1200,#0A1525);border:1px solid var(--border);border-radius:10px;padding:18px 20px;margin-bottom:18px;position:relative;overflow:hidden}
.gw-banner::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--green),var(--amber),var(--blue),var(--green));background-size:200%;animation:shimmer 3s linear infinite}
@keyframes shimmer{0%{background-position:0%}100%{background-position:200%}}
.gw-eq{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.eq-b{background:var(--bg3);border:1px solid var(--border2);border-radius:7px;padding:10px 14px;text-align:center}
.eq-b .ebl{font-size:9px;color:var(--text3);font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.07em;margin-bottom:3px}

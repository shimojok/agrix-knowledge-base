// lib/agrix/module1/orchestrate/full.ts

import { SoilSensorInput } from '../types/mbt55.types';
import { runHypercycleEngine } from '../engines/hypercycle.engine';
import { runBiosecurityEngine } from '../engines/biosecurity.engine';
import { runBiocontrolEngine } from '../engines/biocontrol.engine';
import { runDecomposerEngine } from '../engines/decomposer.engine';

export interface Module1FullOutput {
  timestamp: string;
  version: string;
  
  // 各エージェントの出力
  decomposer: ReturnType<typeof runDecomposerEngine>;
  hypercycle: ReturnType<typeof runHypercycleEngine>;
  biosecurity: ReturnType<typeof runBiosecurityEngine>;
  biocontrol: ReturnType<typeof runBiocontrolEngine>;
  
  // 統合スコア（AGRIX健康度）
  agrixHealthScore: number;      // 0-100
  healthStatus: 'EXCELLENT' | 'GOOD' | 'FAIR' | 'POOR' | 'CRITICAL';
  
  // 主要KPIサマリ（ビル・ゲイツ氏向け）
  summary: {
    carbonSequestrationPotential: number; // tCO2/ha/yr
    diseaseRiskScore: number;             // 0-100（低いほど良い）
    microbialActivityScore: number;       // 0-100
    recommendedAction: string;
  };
  
  // Module2（MSC資材生産）への連携データ
  toModule2: {
    humusProductionPotential: number;     // 腐植質生産ポテンシャル
    fertilizerQualityScore: number;       // 発酵肥料品質スコア
    feedQualityScore: number;             // 発酵飼料品質スコア
  };
  
  // Module3（炭素・GHGアカウンティング）への連携データ
  toModule3: {
    socIncreaseRate: number;              // SOC年間増加率
    stableCarbonSequestration: number;    // 安定炭素隔離量
    ghgReductionPotential: number;        // GHG削減ポテンシャル
  };
}

export function runModule1Full(input: SoilSensorInput): Module1FullOutput {
  // ----- 1. 各エージェント実行 -----
  const decomposer = runDecomposerEngine(input);
  
  // 分解菌活性サマリをハイパーサイクルに渡す
  const hypercycleInput = {
    ...input,
    decomposerActivity: {
      protease: decomposer.decomposers.protease.activity,
      amylase: decomposer.decomposers.amylase.activity,
      lipase: decomposer.decomposers.lipase.activity,
      cellulase: decomposer.decomposers.cellulase.activity,
      total: decomposer.totalActivity,
    },
  };
  const hypercycle = runHypercycleEngine(hypercycleInput);
  
  // バイオセキュリティ実行
  const biosecurityInput = {
    ...input,
    pathogenCounts: {
      fusarium: 120,   // 仮定値（実際はセンサー入力から）
      pythium: 45,
      phytophthora: 30,
      rhizoctonia: 20,
    },
    beneficialMicrobes: 850,
    historicalPathogenTrend: [150, 130, 120, 110, 100],
  };
  const biosecurity = runBiosecurityEngine(biosecurityInput);
  
  // バイオコントロール実行
  const biocontrolInput = {
    ...input,
    ndvi: 0.78,
    pri: 0.52,
    leafTemperature_c: 24.5,
    chlorophyllIndex: 0.65,
    enzymeBetaGlucosidase: 0.72,
    enzymeDehydrogenase: 0.68,
    scfaAcetate: 0.45,
    scfaPropionate: 0.32,
    scfaButyrate: 0.18,
  };
  const biocontrol = runBiocontrolEngine(biocontrolInput);

  // ----- 2. 統合スコア（AGRIX健康度）計算 -----
  const agrixHealthScore = (
    hypercycle.cycleEfficiency * 0.25 +
    hypercycle.humificationRate * 0.20 +
    biosecurity.biomeResilienceScore * 0.20 +
    biocontrol.biocontrolEfficacy * 0.20 +
    decomposer.totalActivity * 0.15
  ) * 100;

  // 健康状態判定
  let healthStatus: Module1FullOutput['healthStatus'] = 'FAIR';
  if (agrixHealthScore >= 85) healthStatus = 'EXCELLENT';
  else if (agrixHealthScore >= 70) healthStatus = 'GOOD';
  else if (agrixHealthScore >= 50) healthStatus = 'FAIR';
  else if (agrixHealthScore >= 30) healthStatus = 'POOR';
  else healthStatus = 'CRITICAL';

  // ----- 3. 主要KPIサマリ -----
  const carbonSequestrationPotential = hypercycle.stableCarbonFraction * 2.5 + hypercycle.humificationRate * 1.0;
  const diseaseRiskScore = (1 - biosecurity.pathogenSuppressionIndex) * 70 + (1 - biocontrol.diseaseSuppressionRate) * 30;
  const microbialActivityScore = decomposer.totalActivity * 100;

  let recommendedAction = '';
  if (agrixHealthScore >= 80) {
    recommendedAction = '✅ 土壌生態系は非常に良好です。現在の管理を継続してください。';
  } else if (agrixHealthScore >= 60) {
    recommendedAction = '📈 土壌生態系は改善傾向です。MBT55投与と有機物投入を継続してください。';
  } else if (agrixHealthScore >= 40) {
    recommendedAction = '⚠️ 土壌生態系に改善の余地があります。pH調整とMBT55投与量の見直しを推奨します。';
  } else {
    recommendedAction = '🔴 土壌生態系が危機的な状態です。早急に総合的な土壌再生対策を実施してください。';
  }

  // ----- 4. Module2（MSC資材生産）連携データ -----
  const toModule2 = {
    humusProductionPotential: Number((hypercycle.humificationRate * 0.7 + hypercycle.stableCarbonFraction * 0.3).toFixed(3)),
    fertilizerQualityScore: Number((hypercycle.resourceConversionRate * 0.5 + decomposer.totalActivity * 0.5).toFixed(3)),
    feedQualityScore: Number((biocontrol.beneficialMicrobeRatio * 0.5 + biosecurity.biomeResilienceScore * 0.5).toFixed(3)),
  };

  // ----- 5. Module3（炭素・GHGアカウンティング）連携データ -----
  const toModule3 = {
    socIncreaseRate: Number((hypercycle.humificationRate * 0.3 + decomposer.decomposers.cellulase.activity * 0.4 + 0.3).toFixed(3)),
    stableCarbonSequestration: Number((hypercycle.stableCarbonFraction * 2.0).toFixed(2)),
    ghgReductionPotential: Number(((1 - biosecurity.diseaseOutbreakRisk) * 0.5 + hypercycle.stableCarbonFraction * 0.5).toFixed(3)),
  };

  return {
    timestamp: new Date().toISOString(),
    version: '1.0.0',
    decomposer,
    hypercycle,
    biosecurity,
    biocontrol,
    agrixHealthScore: Number(agrixHealthScore.toFixed(1)),
    healthStatus,
    summary: {
      carbonSequestrationPotential: Number(carbonSequestrationPotential.toFixed(2)),
      diseaseRiskScore: Number(diseaseRiskScore.toFixed(1)),
      microbialActivityScore: Number(microbialActivityScore.toFixed(1)),
      recommendedAction,
    },
    toModule2,
    toModule3,
  };
}

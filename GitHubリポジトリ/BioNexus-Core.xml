    """JSON ファイルを読み込み、D レコードのリストを返す。"""

def validate_core_pathways(d: dict) -> list[str]:
    """
    core_pathways の値が許可セット内か検証。
    問題があればエラーメッセージのリストを返す。
    """

def check_mi_engine_consistency(d: dict) -> list[str]:
    """
    acetylcoa / estrobolome と related_mi_engines の整合性をチェック。
    問題があれば警告メッセージのリストを返す。
    """

def auto_fix_mi_engines(d: dict) -> bool:
    """
    ルールに基づき MI-AcetylCoA / MI-Estrobolome を追記。
    何か変更した場合 True を返す。
    """

def check_disease_id(d: dict) -> list[str]:
    """
    disease_id の形式（"D" + 数値）を検証。
    問題があればエラーメッセージのリストを返す。
    """

def save_matrix(path: str, records: list[dict]) -> None:
    """修正後のレコードを JSON として保存する。"""
```

### A-3. チェックロジック詳細

**1. core_pathways 値検証**

- 許可値: `{"high", "moderate", "low", "normal"}`
    
- 違反があれば **エラー**として報告（自動修正しない）。
    

**2. MI エンジン整合性**

- **AcetylCoA:**
    
    - 条件:
        
        text
        
        ```
        core_pathways.acetylcoa in {"high", "moderate", "low"}
        ```
        
    - 期待:
        
        text
        
        ```
        "MI-AcetylCoA" in related_mi_engines
        ```
        
- **Estrobolome:**
    
    - 条件:
        
        text
        
        ```
        core_pathways.estrobolome in {"high", "moderate", "low"}
        ```
        
    - 期待:
        
        text
        
        ```
        "MI-Estrobolome" in related_mi_engines
        ```
        
- `--fix` 指定時は、足りない MI を追記（重複チェックあり）。
    

**3. disease_id 検証**

- 正規表現: `^D[0-9]+$`
    
- 重複チェック: `set` で一意性確認。
    


        # 診断ロジック
        is_oxidized = redox < self.health_thresholds["redox_min"]
        is_stagnated = resp_accel < self.health_thresholds["resp_accel_min"]
        
        if is_oxidized and is_stagnated:
            return "DEGRADATION_PHASE"  # 劣化相（未病悪化）
        elif not is_oxidized and is_stagnated:
            return "STAGNATION_PHASE"   # 停滞相（エネルギー不足）
        else:
            return "REGENERATION_PHASE" # 再生相（健全）

    def generate_prescription(self, phase, soil_type):

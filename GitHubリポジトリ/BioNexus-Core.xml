\text{Premium} = \phi_1 \cdot \text{BiosecurityRisk}
+ \phi_2 \cdot \text{YieldVolatility}
- \phi_3 \cdot \text{MBT55\_StabilityIndex}
$$

$$
\mathrm{Premium}
= \phi_1\, \mathrm{BiosecurityRisk}
+ \phi_2\, \mathrm{YieldVolatility}
- \phi_3\, \mathrm{MBT55\_StabilityIndex}
$$

$$
\text{Premium} = \phi_1 \cdot \mathrm{BiosecurityRisk} + \phi_2 \cdot \mathrm{YieldVolatility} - \phi_3 \cdot \mathrm{MBT55\_StabilityIndex}

```python
import json
from typing import Dict, List


class MBT55Cascade:

    def __init__(self, config: Dict):
        self.config = config

    # -----------------------------
    # Stage 1: 加水分解
    # -----------------------------
    def stage1(self, components):
        results = []

        for comp in components:
            complexity = comp["substrate_characteristics"]["complexity"]
            base = complexity * 100

            results.append({
                "name": comp["name_ja"],
                "peptides": base * 0.6,
                "amino_acids": base * 0.3
            })

        return results

    # -----------------------------
    # Stage 2: 代謝変換
    # -----------------------------
    def stage2(self, stage1_out):
        results = []

        for s in stage1_out:
            conversion = (s["peptides"] + s["amino_acids"]) * 0.5

            results.append({
                "name": s["name"],
                "aglycone": conversion * 0.7,
                "scfa": conversion * 0.3
            })

        return results

    # -----------------------------
    # Stage 3: 熟成
    # -----------------------------
    def stage3(self, stage2_out):
        results = []

        for s in stage2_out:
            bioactive = (s["aglycone"] + s["scfa"]) * 1.8

            results.append({
                "name": s["name"],
                "bioactive_total": bioactive
            })

        return results

    # -----------------------------
    # 実行
    # -----------------------------
    def run(self):
        components = self.config.get("crude_drug_components", [])

        s1 = self.stage1(components)
        s2 = self.stage2(s1)
        s3 = self.stage3(s2)

        return {
            "stage1": s1,
            "stage2": s2,
            "stage3": s3
        }
```


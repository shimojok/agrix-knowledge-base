  </div>
  <div class="rp-section">
    <div class="rp-title">// GHG_REDUCTION_SOURCES</div>
    <div class="mb-row"><div class="mb-label">食品ロス削減</div><div class="mb-track"><div class="mb-fill" style="width:82%;background:var(--green)"></div></div><div class="mb-val">8.0%</div></div>
    <div class="mb-row"><div class="mb-label">土壌炭素隔離</div><div class="mb-track"><div class="mb-fill" style="width:65%;background:var(--teal)"></div></div><div class="mb-val">6.5%</div></div>
    <div class="mb-row"><div class="mb-label">廃棄物発酵化</div><div class="mb-track"><div class="mb-fill" style="width:48%;background:var(--amber)"></div></div><div class="mb-val">4.8%</div></div>
    <div class="mb-row"><div class="mb-label">畜産メタン削減</div><div class="mb-track"><div class="mb-fill" style="width:35%;background:var(--blue)"></div></div><div class="mb-val">3.2%</div></div>
    <div class="mb-row"><div class="mb-label">化学肥料代替</div><div class="mb-track"><div class="mb-fill" style="width:28%;background:var(--purple)"></div></div><div class="mb-val">2.1%</div></div>
  </div>
  <div class="rp-section">
    <div class="rp-title">// VALUE_CHAIN_LOG</div>
    <div class="commit-list">
      <div class="commit-item"><div class="commit-dot" style="background:var(--green)"></div><div><div class="ct">MBT農産物購入 → 排出権自動発行</div><div class="cm">AGRIX計測 · PoR verified</div></div></div>
      <div class="commit-item"><div class="commit-dot" style="background:var(--amber)"></div><div><div class="ct">有機廃棄物 → 発酵肥料（24h）</div><div class="cm">MBT55 fermentation · MSC Engine</div></div></div>
      <div class="commit-item"><div class="commit-dot" style="background:var(--blue)"></div><div><div class="ct">HealthBook: 栄養摂取 → 保険料割引</div><div class="cm">Health Actuarial Model · linked</div></div></div>
      <div class="commit-item"><div class="commit-dot" style="background:var(--teal)"></div><div><div class="ct">BioSecurity: コーヒーさび病ゼロ</div><div class="cm">MBT55 fungal suppression · active</div></div></div>
      <div class="commit-item"><div class="commit-dot" style="background:var(--purple)"></div><div><div class="ct">廃棄物処理予算 → MSC設備収益</div><div class="cm">Gov. contract · budget absorption</div></div></div>
      <div class="commit-item"><div class="commit-dot" style="background:var(--red)"></div><div><div class="ct">ACIB債発行 → 農地炭素担保化</div><div class="cm">Climate finance · new asset class</div></div></div>
    </div>
  </div>
</div>

</div><!-- end layout -->

<!-- EXPORT MODAL -->
<div class="modal-overlay" id="exportModal">
  <div class="modal" id="modalContent">
    <h2 id="modalTitle">📄 Export</h2>
    <p id="modalDesc">エクスポート形式を選択してください</p>
    <div class="export-options" id="exportOptions">
      <div class="exp-opt selected" onclick="selectExport(this,'current')">
        <div class="eo-icon">🖥</div>
        <div class="eo-title">現在のタブ</div>
        <div class="eo-desc">表示中の画面をキャプチャ</div>
      </div>
      <div class="exp-opt" onclick="selectExport(this,'full')">
        <div class="eo-icon">📋</div>
        <div class="eo-title">全タブ</div>
        <div class="eo-desc">Overview + MSC + Finance + Impact</div>
      </div>
    </div>
    <div class="progress-bar" id="exportProgress"><div class="pb-fill" id="pbFill"></div></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-primary" onclick="executeExport()" id="exportExecBtn">Export</button>
    </div>
  </div>
</div>

<script>
// ── TAB SWITCHING ──
function switchTab(name, el) {
  document.querySelectorAll('.page-view').forEach(v => v.classList.remove('active'));
  document.getElementById('view-' + name).classList.add('active');
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  if (el) el.classList.add('active');
  else {
    const tabs = document.querySelectorAll('.tab');
    const map = {overview:0,msc:1,finance:2,impact:3};
    if (map[name]!==undefined) tabs[map[name]].classList.add('active');
  }
  if (name === 'overview') initCanvas();
}

// ── EXPORT MENU ──
function toggleExportMenu() {
  document.getElementById('exportMenu').classList.toggle('open');
}
document.addEventListener('click', e => {
  if (!e.target.closest('.export-dropdown')) {
    document.getElementById('exportMenu').classList.remove('open');
  }
});

let currentExportType = 'pdf';
let currentExportScope = 'current';
function openExportModal(type) {
  currentExportType = type;
  document.getElementById('exportMenu').classList.remove('open');
  const titles = {pdf:'📄 PDF Pitch Deck', png:'🖼 PNG Snapshot', slides:'📊 Slide Preview', wp:'📝 White Paper Data'};
  const descs = {
    pdf:'投資家・国際機関向けPBPEモデルのPDFピッチデックを生成します。',
    png:'現在の画面のPNGスナップショットをダウンロードします。',
    slides:'スライド構成プレビューを表示します（Impactタブ）。',
    wp:'PBPEモデルのWhite Paper用データをJSON形式でエクスポートします。'
  };
  document.getElementById('modalTitle').textContent = titles[type];
  document.getElementById('modalDesc').textContent = descs[type];
  document.getElementById('exportModal').classList.add('open');
}
function closeModal() {
  document.getElementById('exportModal').classList.remove('open');
  document.getElementById('exportProgress').style.display = 'none';
  document.getElementById('pbFill').style.width = '0%';
}
function selectExport(el, scope) {
  document.querySelectorAll('.exp-opt').forEach(o => o.classList.remove('selected'));
  el.classList.add('selected');
  currentExportScope = scope;
}
function executeExport() {
  const btn = document.getElementById('exportExecBtn');
  btn.textContent = 'Processing...';
  btn.disabled = true;
  const pb = document.getElementById('exportProgress');
  const fill = document.getElementById('pbFill');
  pb.style.display = 'block';

  if (currentExportType === 'png') {
    fill.style.width = '30%';
    setTimeout(() => {
      const target = document.querySelector('.main');
      html2canvas(target, {
        backgroundColor: '#0D1117',
        scale: 1.5,
        useCORS: true,
        allowTaint: true
      }).then(canvas => {
        fill.style.width = '90%';
        const link = document.createElement('a');
        link.download = 'PBPE-Dashboard-' + new Date().toISOString().slice(0,10) + '.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
        fill.style.width = '100%';
        setTimeout(() => { closeModal(); btn.textContent='Export'; btn.disabled=false; }, 600);
      });
    }, 200);
  } else if (currentExportType === 'wp') {
    fill.style.width = '50%';
    const data = {
      model: "PBPE — Plant-Based Planet Economy",
      version: "2.0",
      gateway: "農産物取引 ≡ 排出権取引",
      engine: "MBT Sustainable Cycle (MSC)",
      problems_solved: ["食料問題","栄養問題","医療費問題","温室効果ガス削減","食品企業収益向上","投資家収益向上","保険・気候ファイナンス流動化"],
      financial_products: ["ACIB (農地炭素担保型インフラ債)","ARS (農業収益スワップ)","SAM (土壌資産担保モーゲージ)","HALI (農業健康連動保険)"],
      kpis: {food_loss_reduction:"-30%", ghg_reduction:"-22%", healthcare_savings:"-$2.3T", climate_finance_unlocked:"$850B", yield_stability:"+25%"},
      biosecurity_coverage: ["コーヒーさび病","柑橘グリーニング病","鳥インフルエンザ","豚熱(CSF/ASF)","養殖魚病原菌"],
      revenue_streams: ["農産物販売収益","廃棄物処理委託収益","発酵肥料・飼料販売","炭素クレジット(PoR)","バイオセキュリティ提供料"],
      sdgs: ["SDG 2: Zero Hunger","SDG 3: Good Health","SDG 13: Climate Action","SDG 15: Life on Land","SDG 17: Partnerships"],
      generated: new Date().toISOString()
    };
    fill.style.width = '90%';
    const blob = new Blob([JSON.stringify(data, null, 2)], {type:'application/json'});
    const link = document.createElement('a');
    link.download = 'PBPE-WhitePaper-Data-' + new Date().toISOString().slice(0,10) + '.json';
    link.href = URL.createObjectURL(blob);
    link.click();
    fill.style.width = '100%';
    setTimeout(() => { closeModal(); btn.textContent='Export'; btn.disabled=false; }, 600);
  } else if (currentExportType === 'slides' || currentExportType === 'pdf') {
    fill.style.width = '40%';
    switchTab('impact', null);
    setTimeout(() => {
      fill.style.width = '70%';
      html2canvas(document.getElementById('mainContent'), {
        backgroundColor: '#0D1117', scale: 1.5, useCORS: true, allowTaint: true
      }).then(canvas => {
        fill.style.width = '95%';
        const link = document.createElement('a');
        const ext = currentExportType === 'pdf' ? 'png' : 'png';
        link.download = 'PBPE-PitchDeck-' + new Date().toISOString().slice(0,10) + '.' + ext;
        link.href = canvas.toDataURL('image/png');
        link.click();
        fill.style.width = '100%';
        setTimeout(() => { closeModal(); btn.textContent='Export'; btn.disabled=false; }, 600);
      });
    }, 400);
  }
}

// ── HYPERCYCLE CANVAS ──
let animId = null;
function initCanvas() {
  if (animId) { cancelAnimationFrame(animId); animId = null; }
  const canvas = document.getElementById('hypercycle');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  function resize() {
    const rect = canvas.parentElement.getBoundingClientRect();
    canvas.width = (rect.width - 12) * window.devicePixelRatio;
    canvas.height = 400 * window.devicePixelRatio;
    canvas.style.height = '400px';
    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  }
  resize();
  const W = () => canvas.width / window.devicePixelRatio;
  const H = () => canvas.height / window.devicePixelRatio;

  const nodes = [
    {id:'msc',label:'MBT Sustainable\nCycle',sub:'ENGINE',x:.5,y:.5,r:50,color:'#F0A500',glow:'#F0A50040',isMSC:true},
    {id:'food',label:'食料問題',sub:'FOOD SECURITY',x:.5,y:.08,r:34,color:'#39D353',glow:'#39D35330'},
    {id:'nutri',label:'栄養問題',sub:'NUTRITION',x:.82,y:.2,r:34,color:'#58A6FF',glow:'#58A6FF30'},
    {id:'medical',label:'医療費問題',sub:'HEALTHCARE',x:.93,y:.55,r:34,color:'#BC8CFF',glow:'#BC8CFF30'},
    {id:'ghg',label:'GHG削減',sub:'CLIMATE',x:.72,y:.89,r:34,color:'#3DCFCF',glow:'#3DCFCF30'},
    {id:'food_ent',label:'食品企業\n収益',sub:'FOOD BIZ',x:.28,y:.89,r:34,color:'#C9A84C',glow:'#C9A84C30'},
    {id:'invest',label:'投資家\n収益',sub:'INVESTORS',x:.07,y:.55,r:34,color:'#F85149',glow:'#F8514930'},
    {id:'insure',label:'保険・\n気候Finance',sub:'RISK+FINANCE',x:.18,y:.2,r:34,color:'#FF9F43',glow:'#FF9F4330'},
  ];
  const edges = nodes.slice(1).map((n,i) => ({to:n.id, color:n.color, phase:(i/7)*Math.PI*2}));

  function gp(n) { return {x:n.x*W(), y:n.y*H()}; }

  function drawGlow(x,y,r,color) {
    const g = ctx.createRadialGradient(x,y,r*.2,x,y,r*2.4);
    g.addColorStop(0,color); g.addColorStop(1,'transparent');
    ctx.beginPath(); ctx.arc(x,y,r*2.4,0,Math.PI*2); ctx.fillStyle=g; ctx.fill();
  }

  function drawPulse(from,to,color,phase,t) {
    ctx.beginPath(); ctx.moveTo(from.x,from.y); ctx.lineTo(to.x,to.y);
    ctx.strokeStyle=color+'22'; ctx.lineWidth=1.5; ctx.stroke();
    const p = ((t*.00065+phase)%1+1)%1;
    const px=from.x+(to.x-from.x)*p, py=from.y+(to.y-from.y)*p;
    const bg=ctx.createRadialGradient(px,py,0,px,py,9);
    bg.addColorStop(0,color+'FF'); bg.addColorStop(.5,color+'60'); bg.addColorStop(1,'transparent');
    ctx.beginPath(); ctx.arc(px,py,9,0,Math.PI*2); ctx.fillStyle=bg; ctx.fill();
    ctx.beginPath(); ctx.arc(px,py,2.5,0,Math.PI*2); ctx.fillStyle=color; ctx.fill();
  }

  function drawNode(n,p,t) {
    drawGlow(p.x,p.y,n.r,n.glow);
    if (n.isMSC) {
      const pulse=1+Math.sin(t*.002)*.07;
      [12,22].forEach((d,i) => {
        ctx.beginPath(); ctx.arc(p.x,p.y,n.r*pulse+d,0,Math.PI*2);
        ctx.strokeStyle=n.color+(i?'14':'35'); ctx.lineWidth=1.5+i*.5; ctx.stroke();
      });
    }
    const grd=ctx.createRadialGradient(p.x-n.r*.2,p.y-n.r*.2,n.r*.1,p.x,p.y,n.r);
    if (n.isMSC) { grd.addColorStop(0,'#3A2A00'); grd.addColorStop(1,'#1A1000'); }
    else { grd.addColorStop(0,'#21262D'); grd.addColorStop(1,'#161B22'); }
    ctx.beginPath(); ctx.arc(p.x,p.y,n.r,0,Math.PI*2);
    ctx.fillStyle=grd; ctx.fill();
    ctx.strokeStyle=n.color+(n.isMSC?'CC':'70'); ctx.lineWidth=n.isMSC?2:1.5; ctx.stroke();
    ctx.textAlign='center'; ctx.textBaseline='middle';
    const lines=n.label.split('\n');
    if (n.isMSC) {
      ctx.font='700 11px "JetBrains Mono",monospace'; ctx.fillStyle=n.color;
      lines.forEach((l,i) => ctx.fillText(l,p.x,p.y+(i-(lines.length-1)/2)*14));
      ctx.font='500 8px "JetBrains Mono",monospace'; ctx.fillStyle=n.color+'70';
      ctx.fillText(n.sub,p.x,p.y+24);
    } else {
      ctx.font='600 10px Inter,sans-serif'; ctx.fillStyle='#E6EDF3';
      lines.forEach((l,i) => ctx.fillText(l,p.x,p.y+(i-(lines.length-1)/2)*13-4));
      ctx.font='400 8px "JetBrains Mono",monospace'; ctx.fillStyle=n.color+'AA';
      ctx.fillText(n.sub,p.x,p.y+lines.length*7+2);
    }
  }

  function draw(ts) {
    ctx.clearRect(0,0,W(),H());
    ctx.fillStyle='#30363D15';
    for (let gx=20;gx<W();gx+=36) for (let gy=20;gy<H();gy+=36) {
      ctx.beginPath(); ctx.arc(gx,gy,1,0,Math.PI*2); ctx.fill();
    }
    const pos={};
    nodes.forEach(n => pos[n.id]=gp(n));
    edges.forEach(e => drawPulse(pos['msc'],pos[e.to],e.color,e.phase,ts));
    nodes.forEach(n => drawNode(n,pos[n.id],ts));
    animId = requestAnimationFrame(draw);
  }
  animId = requestAnimationFrame(draw);
}

// init on load
window.addEventListener('load', initCanvas);
window.addEventListener('resize', () => { if(document.getElementById('view-overview').classList.contains('active')) initCanvas(); });
</script>
</body>
</html>

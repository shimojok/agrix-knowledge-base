    def analyze_metabolic_imbalance(self, 
                                  questionnaire_responses: Dict[int, bool],
                                  lab_data: Dict[str, float] = None) -> Dict:
        """
        代謝不全の詳細分析
        浜田式アルゴリズムに基づく
        """
        analysis = {
            "metabolic_profiles": {},
            "disease_risks": {},
            "imbalance_patterns": [],
            "intervention_strategy": {},
            "confidence_level": 0.0
        }
        
        # 1. 代謝プロファイルの評価
        metabolic_scores = self._evaluate_metabolic_profiles(questionnaire_responses)
        analysis["metabolic_profiles"] = metabolic_scores
        
        # 2. 疾病リスクの評価
        disease_risks = self._evaluate_disease_risks(questionnaire_responses, metabolic_scores)
        analysis["disease_risks"] = disease_risks
        
        # 3. 検査データによる調整
        if lab_data:
            adjusted_risks = self._adjust_with_lab_data(disease_risks, lab_data)
            analysis["disease_risks"] = adjusted_risks
        
        # 4. 代謝不全パターンの特定
        imbalance_patterns = self._identify_imbalance_patterns(metabolic_scores, questionnaire_responses)
        analysis["imbalance_patterns"] = imbalance_patterns
        
        # 5. 介入戦略の生成
        intervention = self._generate_intervention_strategy(imbalance_patterns, disease_risks)
        analysis["intervention_strategy"] = intervention
        
        # 6. 信頼度の計算
        confidence = self._calculate_confidence(questionnaire_responses, lab_data)
        analysis["confidence_level"] = confidence
        
        return analysis
    
    def _evaluate_metabolic_profiles(self, responses: Dict[int, bool]) -> Dict[str, float]:
        """代謝プロファイルの評価"""
        profile_scores = {}
        
        for profile_name, profile_info in self.metabolic_profiles.items():
            total_weight = 0
            matched_questions = 0
            
            for q_id in profile_info["key_questions"]:
                if q_id in responses and responses[q_id]:
                    # 質問の有意性を考慮
                    significance = self.question_significance.get(q_id, {"weight": 0.5})
                    total_weight += significance["weight"]
                    matched_questions += 1
            
            # スコア計算（マッチした質問の割合 × 平均重み）
            if profile_info["key_questions"]:
                question_ratio = matched_questions / len(profile_info["key_questions"])
                avg_weight = total_weight / matched_questions if matched_questions > 0 else 0
                score = question_ratio * avg_weight
                
                # 重症度分類
                thresholds = profile_info["severity_thresholds"]
                if score >= thresholds["重度"]:
                    severity = "重度"
                elif score >= thresholds["中度"]:
                    severity = "中度"
                elif score >= thresholds["軽度"]:
                    severity = "軽度"
                else:
                    severity = "正常範囲"
                
                profile_scores[profile_name] = {
                    "score": round(score, 3),
                    "severity": severity,
                    "matched_questions": matched_questions,
                    "total_questions": len(profile_info["key_questions"]),
                    "key_findings": self._extract_key_findings(profile_name, responses)
                }
        
        return profile_scores
    
    def _evaluate_disease_risks(self, responses: Dict[int, bool], 
                               metabolic_scores: Dict) -> Dict[str, Dict]:
        """疾病リスクの詳細評価"""
        disease_risks = {}
        
        for disease, pattern in self.disease_patterns.items():
            # 基本スコア計算
            base_score = self._calculate_disease_base_score(disease, responses)
            
            # 代謝プロファイルによる調整
            metabolic_profile = pattern["metabolic_profile"]
            if metabolic_profile in metabolic_scores:
                metabolic_impact = metabolic_scores[metabolic_profile]["score"]
                adjusted_score = base_score * (1 + metabolic_impact * 0.5)
            else:
                adjusted_score = base_score
            
            # サブタイプの特定
            subtype = self._identify_subtype(disease, responses)
            
            # リスクレベル分類
            risk_level = self._classify_risk_level(adjusted_score)
            
            # 介入ポイントの優先度付け
            intervention_priority = self._prioritize_interventions(disease, responses, metabolic_scores)
            
            disease_risks[disease] = {
                "base_score": round(base_score, 3),
                "adjusted_score": round(min(adjusted_score, 1.0), 3),
                "risk_level": risk_level,
                "subtype": subtype,
                "metabolic_basis": pattern["metabolic_profile"],
                "key_indicators": self._extract_key_indicators(disease, responses),
                "intervention_priority": intervention_priority,
                "predicted_response": pattern.get("response_prediction", {})
            }
        
        return disease_risks
    
    def _calculate_disease_base_score(self, disease: str, responses: Dict[int, bool]) -> float:
        """疾病の基本スコア計算"""
        pattern = self.disease_patterns[disease]
        question_weights = pattern["key_indicators"]["question_weights"]
        
        total_weight = 0
        matched_weight = 0
        
        for q_id, weight in question_weights.items():
            total_weight += weight
            if q_id in responses and responses[q_id]:
                matched_weight += weight
        
        return matched_weight / total_weight if total_weight > 0 else 0
    
    def _identify_subtype(self, disease: str, responses: Dict[int, bool]) -> str:
        """疾病サブタイプの特定"""
        pattern = self.disease_patterns[disease]
        
        # 質問パターンに基づくサブタイプ分類
        if disease == "高血圧":
            # ナトリウム感受性 vs ストレス性 vs 遺伝性
            salt_questions = [3, 25, 67]  # 塩分関連
            stress_questions = [89, 112, 145]  # ストレス関連
            
            salt_score = sum(1 for q in salt_questions if q in responses and responses[q])
            stress_score = sum(1 for q in stress_questions if q in responses and responses[q])
            
            if salt_score >= 2:
                return "ナトリウム感受性型"
            elif stress_score >= 2:
                return "ストレス性型"
            else:
                return "その他の型"
        
        elif disease == "糖尿病":
            # インスリン抵抗性 vs インスリン分泌不全
            insulin_resistance_questions = [6, 8, 45]  # 肥満・運動不足関連
            secretion_questions = [1, 25, 78]  # 食習慣関連
            
            resistance_score = sum(1 for q in insulin_resistance_questions 
                                 if q in responses and responses[q])
            secretion_score = sum(1 for q in secretion_questions 
                                if q in responses and responses[q])
            
            if resistance_score >= 2:
                return "インスリン抵抗性型"
            elif secretion_score >= 2:
                return "インスリン分泌不全型"
            else:
                return "混合型"
        
        return pattern.get("subtype", "標準型")
    
    def _classify_risk_level(self, score: float) -> str:
        """リスクレベルの分類"""
        if score >= 0.8:
            return "非常に高いリスク"
        elif score >= 0.6:
            return "高いリスク"
        elif score >= 0.4:
            return "中等度リスク"
        elif score >= 0.2:
            return "軽度リスク"
        else:
            return "低リスク"
    
    def _prioritize_interventions(self, disease: str, responses: Dict[int, bool],
                                 metabolic_scores: Dict) -> List[Dict]:
        """介入ポイントの優先度付け"""
        pattern = self.disease_patterns[disease]
        interventions = pattern.get("intervention_points", [])
        
        # 質問回答に基づく優先度調整
        for intervention in interventions:
            target = intervention["target"]
            
            if target == "ナトリウム摂取":
                # 塩分関連質問の数で優先度調整
                salt_questions = [3, 25, 67]
                salt_count = sum(1 for q in salt_questions if q in responses and responses[q])
                intervention["adjusted_priority"] = intervention["priority"] * (1 + salt_count * 0.3)
            
            elif target == "糖質制限":
                # 糖質関連質問の数で優先度調整
                sugar_questions = [6, 25, 67]
                sugar_count = sum(1 for q in sugar_questions if q in responses and responses[q])
                intervention["adjusted_priority"] = intervention["priority"] * (1 + sugar_count * 0.4)
            
            elif target == "ストレス管理":
                # ストレス関連質問の数で優先度調整
                stress_questions = [89, 112, 145]
                stress_count = sum(1 for q in stress_questions if q in responses and responses[q])
                intervention["adjusted_priority"] = intervention["priority"] * (1 + stress_count * 0.5)
        
        # 優先度順にソート
        interventions.sort(key=lambda x: x.get("adjusted_priority", x["priority"]), reverse=True)
        
        return interventions
    
    def _extract_key_indicators(self, disease: str, responses: Dict[int, bool]) -> List[str]:
        """主要指標の抽出"""
        pattern = self.disease_patterns[disease]
        indicators = []
        
        for q_id in pattern["key_indicators"]["question_weights"].keys():
            if q_id in responses and responses[q_id]:
                # 質問IDに対応する実際の質問文を取得（簡易版）
                question_texts = {
                    1: "朝食抜き",
                    3: "塩分摂取過多",
                    6: "糖質摂取過多",
                    8: "運動不足",
                    25: "加工食品依存",
                    67: "清涼飲料水常用",
                    89: "ストレス過多"
                }
                indicators.append(question_texts.get(q_id, f"質問{q_id}"))
        
        return indicators[:5]  # 上位5つを返す
    
    def _identify_imbalance_patterns(self, metabolic_scores: Dict,
                                    responses: Dict[int, bool]) -> List[Dict]:
        """代謝不全パターンの特定"""
        patterns = []
        
        # 複合代謝異常の検出
        high_score_profiles = [
            (name, data["score"]) 
            for name, data in metabolic_scores.items() 
            if data["score"] >= 0.5
        ]
        
        if len(high_score_profiles) >= 2:
            # 複数の代謝異常が同時に存在
            pattern = {
                "type": "複合代謝異常",
                "profiles": [name for name, score in high_score_profiles],
                "severity": "高度",
                "implications": "複数の代謝経路に障害。統合的なアプローチが必要。",
                "key_questions": self._find_common_questions(high_score_profiles, responses)
            }
            patterns.append(pattern)
        
        # 特定の質問パターンに基づく代謝不全
        specific_patterns = self._detect_specific_patterns(responses)
        patterns.extend(specific_patterns)
        
        return patterns
    
    def _find_common_questions(self, profiles: List[Tuple], responses: Dict[int, bool]) -> List[int]:
        """共通の質問項目を検出"""
        common_questions = []
        
        for profile_name, score in profiles:
            profile_info = self.metabolic_profiles[profile_name]
            for q_id in profile_info["key_questions"]:
                if q_id in responses and responses[q_id]:
                    common_questions.append(q_id)
        
        # 出現頻度順にソート
        from collections import Counter
        freq = Counter(common_questions)
        return [q_id for q_id, count in freq.most_common(5)]
    
    def _detect_specific_patterns(self, responses: Dict[int, bool]) -> List[Dict]:
        """特定の代謝不全パターンを検出"""
        patterns = []
        
        # 例：インスリン抵抗性パターン
        insulin_pattern_questions = [1, 6, 8, 45]  # 朝食抜き、甘い物、運動不足、夜食
        insulin_count = sum(1 for q in insulin_pattern_questions if q in responses and responses[q])
        
        if insulin_count >= 3:
            patterns.append({
                "type": "インスリン抵抗性パターン",
                "description": "食習慣の乱れと運動不足による糖代謝異常",
                "confidence": 0.85,
                "recommendations": [
                    "規則正しい食事",
                    "週3回以上の有酸素運動",
                    "食物繊維摂取の増加"
                ]
            })
        
        # 例：慢性炎症パターン
        inflammation_questions = [2, 9, 28, 89]  # 脂肪摂取、揚げ物、ストレス
        inflammation_count = sum(1 for q in inflammation_questions if q in responses and responses[q])
        
        if inflammation_count >= 3:
            patterns.append({
                "type": "慢性炎症パターン",
                "description": "脂質代謝異常とストレスによる全身性炎症",
                "confidence": 0.78,
                "recommendations": [
                    "オメガ3脂肪酸の摂取",
                    "抗酸化物質の増加",
                    "ストレス管理の徹底"
                ]
            })
        
        return patterns
    
    def _generate_intervention_strategy(self, imbalance_patterns: List[Dict],
                                       disease_risks: Dict) -> Dict:
        """介入戦略の生成"""
        strategy = {
            "priority_levels": {},
            "timeline": {},
            "monitoring_points": []
        }
        
        # 高リスク疾病の介入優先度
        high_risk_diseases = [
            (disease, data) 
            for disease, data in disease_risks.items() 
            if data["risk_level"] in ["非常に高いリスク", "高いリスク"]
        ]
        
        for disease, data in high_risk_diseases[:3]:  # 上位3つ
            strategy["priority_levels"][disease] = {
                "level": "高優先度",
                "actions": data["intervention_priority"],
                "expected_timeline": "1-3ヶ月での改善目標",
                "success_indicators": data.get("predicted_response", {})
            }
        
        # 代謝不全パターンへの対応
        for pattern in imbalance_patterns:
            pattern_type = pattern["type"]
            strategy["priority_levels"][pattern_type] = {
                "level": "中優先度",
                "actions": pattern.get("recommendations", []),
                "expected_timeline": "3-6ヶ月での改善目標"
            }
        
        # モニタリングポイントの設定
        strategy["monitoring_points"] = [
            {"interval": "2週間後", "check": "食事記録の確認"},
            {"interval": "1ヶ月後", "check": "症状の変化評価"},
            {"interval": "3ヶ月後", "check": "生活習慣改善の定着度"}
        ]
        
        return strategy
    
    def _adjust_with_lab_data(self, disease_risks: Dict, lab_data: Dict[str, float]) -> Dict:
        """検査データによるリスク調整"""
        adjusted = disease_risks.copy()
        
        for disease, data in adjusted.items():
            adjustment_factor = 1.0
            
            if disease == "高血圧" and "血圧" in lab_data:
                bp = lab_data["血圧"]
                if bp > 140:
                    adjustment_factor *= 1.3
                elif bp > 130:
                    adjustment_factor *= 1.1
            
            elif disease == "糖尿病" and "血糖" in lab_data:
                glucose = lab_data["血糖"]
                if glucose > 126:
                    adjustment_factor *= 1.4
                elif glucose > 110:
                    adjustment_factor *= 1.2
            
            data["lab_adjusted_score"] = min(data["adjusted_score"] * adjustment_factor, 1.0)
            data["lab_adjustment_factor"] = adjustment_factor
        
        return adjusted
    
    def _calculate_confidence(self, responses: Dict[int, bool], 
                             lab_data: Dict = None) -> float:
        """分析の信頼度計算"""
        confidence = 0.0
        
        # 問診回答の完全性
        answered_count = len([v for v in responses.values() if v is not None])
        completeness = answered_count / 50  # サンプル50問で計算
        confidence += completeness * 0.6
        
        # 検査データの有無
        if lab_data and len(lab_data) >= 3:
            confidence += 0.3
        
        # 回答の一貫性チェック
        consistency = self._check_response_consistency(responses)
        confidence += consistency * 0.1
        
        return min(confidence, 1.0)
    
    def _check_response_consistency(self, responses: Dict[int, bool]) -> float:
        """回答の一貫性チェック"""
        # 関連する質問間の一貫性を評価
        consistency_pairs = [
            ([1, 25], 0.8),  # 朝食抜きと間食の関連性
            ([6, 45], 0.7),  # 甘い物と夜食の関連性
            ([8, 89], 0.6)   # 運動不足とストレスの関連性
        ]
        
        matches = 0
        total_pairs = 0
        
        for question_ids, expected_correlation in consistency_pairs:
            values = [responses.get(q, None) for q in question_ids]
            if all(v is not None for v in values):
                total_pairs += 1
                # すべてTrueまたはすべてFalseなら一貫性あり
                if len(set(values)) == 1:
                    matches += 1
        
        return matches / total_pairs if total_pairs > 0 else 0.5

# ==================== デモ実行 ====================

def demonstrate_hamada_algorithm():
    """浜田式アルゴリズムのデモ実行"""
    print("\n" + "="*80)
    print("浜田式診断アルゴリズム デモ")
    print("="*80)
    
    engine = HamadaDiagnosticEngine()
    
    # サンプル問診回答（高リスクパターン）
    sample_responses = {
        1: True,   # 朝食抜き
        3: True,   # 塩辛い物好き
        6: True,   # 甘い物好き
        8: True,   # 運動不足
        25: True,  # 間食多い
        45: True,  # 夜食多い
        67: True,  # 清涼飲料水
        89: True,  # ストレス多い
        112: False # 喫煙なし
    }
    
    # サンプル検査データ
    sample_lab_data = {
        "血圧": 145,
        "血糖": 118,
        "LDL": 158
    }
    
    print("\n📋 問診回答サンプル:")
    for q_id, response in sample_responses.items():
        status = "はい" if response else "いいえ"
        print(f"  質問{q_id}: {status}")
    
    print("\n🔬 検査データサンプル:")
    for test, value in sample_lab_data.items():
        print(f"  {test}: {value}")
    
    print("\n🧠 浜田式アルゴリズム実行中...")
    analysis = engine.analyze_metabolic_imbalance(sample_responses, sample_lab_data)
    
    # 結果表示
    display_hamada_results(analysis)
    
    return analysis

def display_hamada_results(analysis: Dict):
    """浜田式分析結果の表示"""
    print("\n" + "="*80)
    print("浜田式診断結果")
    print("="*80)
    
    # 1. 代謝プロファイル
    print("\n📊 代謝プロファイル評価:")
    for profile, data in analysis["metabolic_profiles"].items():
        print(f"  • {profile}:")
        print(f"    スコア: {data['score']:.1%} ({data['severity']})")
        print(f"    マッチ質問: {data['matched_questions']}/{data['total_questions']}")
        if data['key_findings']:
            print(f"    主な所見: {', '.join(data['key_findings'][:3])}")
    
    # 2. 疾病リスク
    print("\n⚠️ 主要疾病リスク:")
    disease_risks = analysis["disease_risks"]
    sorted_risks = sorted(
        disease_risks.items(),
        key=lambda x: x[1].get("lab_adjusted_score", x[1]["adjusted_score"]),
        reverse=True
    )
    
    for disease, data in sorted_risks[:5]:
        score = data.get("lab_adjusted_score", data["adjusted_score"])
        level = data["risk_level"]
        
        # リスクレベルに応じたアイコン
        if "非常に高い" in level or "高い" in level:
            icon = "🔴"
        elif "中等度" in level:
            icon = "🟡"
        else:
            icon = "🟢"
        
        print(f"  {icon} {disease}:")
        print(f"    リスクスコア: {score:.1%} ({level})")
        print(f"    サブタイプ: {data['subtype']}")
        print(f"    代謝基盤: {data['metabolic_basis']}")
        
        if data['key_indicators']:
            print(f"    主要指標: {', '.join(data['key_indicators'][:3])}")
    
    # 3. 代謝不全パターン
    print("\n🔍 代謝不全パターン:")
    for pattern in analysis["imbalance_patterns"]:
        print(f"  • {pattern['type']}:")
        print(f"    {pattern['description']}")
        print(f"    信頼度: {pattern.get('confidence', 0):.0%}")
    
    # 4. 介入戦略
    print("\n🎯 介入戦略:")
    strategy = analysis["intervention_strategy"]
    for target, plan in list(strategy["priority_levels"].items())[:3]:
        print(f"  • {target} ({plan['level']}):")
        for action in plan.get("actions", [])[:2]:
            if isinstance(action, dict):
                print(f"    - {action.get('target', '')}: {action.get('goal', '')}")
            else:
                print(f"    - {action}")
    
    # 5. 信頼度
    print(f"\n📈 分析信頼度: {analysis['confidence_level']:.0%}")
    
    print("\n" + "="*80)

if __name__ == "__main__":
    demonstrate_hamada_algorithm()

    PATH_04 = "酵母・芳香族分解"
    PATH_05 = "多糖類分解・プレバイオティクス"

class DefenseType(Enum):
    """下條式防御タイプ"""
    HYDROPHILIC = "水溶性防御（体液・血液保護）"
    LIPOPHILIC = "脂溶性防御（細胞膜・脂質保護）"
    SULFUR = "イオウ化合物（循環・抗菌）"


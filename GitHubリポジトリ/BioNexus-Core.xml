        }
        
        return data
    
    def _collect_questionnaire(self) -> Dict:
        """問診データ収集（簡易版）"""
        print("\n健康問診（サンプル5問）:")
        
        questions = [
            "朝食を抜くことが多いですか？",
            "塩辛い食べ物が好きですか？",
            "ストレスを感じることが多いですか？",
            "運動をする習慣がほとんどありませんか？",
            "甘い物をよく摂取しますか？"
        ]
        
        responses = {}
        
        for i, question in enumerate(questions, 1):
            while True:
                answer = input(f"{i}. {question} (はい/いいえ): ").strip().lower()
                if answer in ['はい', 'yes', 'y', '1']:
                    responses[f"q{i}"] = True
                    break
                elif answer in ['いいえ', 'no', 'n', '0']:
                    responses[f"q{i}"] = False
                    break
                else:
                    print("「はい」か「いいえ」で答えてください。")
        
        return responses
    
    def _collect_health_check(self) -> Dict:
        """健康診断データ収集（簡易版）"""
        print("\n最近の健康診断データ（任意）:")
        
        data = {}
        
        # 血圧
        bp_input = input("血圧は正常ですか？ (はい/いいえ/わからない): ").strip().lower()
        if bp_input in ['いいえ', 'no', 'n']:
            data["blood_pressure"] = {"systolic": 145, "diastolic": 95}
        elif bp_input in ['はい', 'yes', 'y']:
            data["blood_pressure"] = {"systolic": 120, "diastolic": 80}
        
        # 血糖値
        glucose_input = input("血糖値は正常ですか？ (はい/いいえ/わからない): ").strip().lower()
        if glucose_input in ['いいえ', 'no', 'n']:
            data["blood_glucose"] = {"fasting": 130, "postprandial": 180}
        elif glucose_input in ['はい', 'yes', 'y']:
            data["blood_glucose"] = {"fasting": 95, "postprandial": 140}
        
        return data
    
    def _collect_lifestyle(self) -> Dict:
        """生活習慣データ収集"""
        print("\n生活習慣について:")
        
        habits = {}
        
        # 運動習慣
        exercise = input("週に何回運動しますか？ (0-7): ").strip()
        try:
            habits["exercise_frequency"] = int(exercise)
        except:
            habits["exercise_frequency"] = 2
        
        # 睡眠時間
        sleep = input("1日の平均睡眠時間は？ (時間): ").strip()
        try:
            habits["sleep_hours"] = float(sleep)
        except:
            habits["sleep_hours"] = 6.5
        
        # 野菜摂取
        vegetables = input("1日の野菜摂取量は？ (少ない/普通/多い): ").strip().lower()
        habits["vegetable_intake"] = vegetables
        
        return habits
    
    def analyze_user_data(self, user_data: Dict) -> Dict:
        """ユーザーデータ分析"""
        # リスク計算
        risk_results = self.risk_calculator.calculate_comprehensive_risk(
            user_data.get("questionnaire", {}),
            user_data.get("health_check", {}),
            user_data.get("genetic", {})
        )
        
        # ヘルススコア計算
        overall_score = self._calculate_overall_score(risk_results)
        
        # リスク分布
        risk_distribution = self._calculate_risk_distribution(risk_results)
        
        # トップリスク抽出
        top_risks = self._extract_top_risks(risk_results)
        
        # 推奨事項生成
        recommendations = self._generate_recommendations(user_data, risk_results)
        
        # 最終結果
        analysis_results = {
            "user_data_summary": self._summarize_user_data(user_data),
            "risk_analysis": risk_results,
            "overall_score": overall_score,
            "risk_distribution": risk_distribution,
            "top_risks": top_risks,
            "recommendations": recommendations,
            "generated_at": datetime.datetime.now().isoformat(),
            "analysis_version": "2.0-extended"
        }
        
        return analysis_results
    
    def _calculate_overall_score(self, risk_results: Dict) -> float:
        """総合ヘルススコア計算"""
        basic_risks = risk_results.get("basic_risk", {})
        
        if not basic_risks:
            return 0.7  # デフォルト値
        
        # 全疾病の平均リスクを計算し、反転（リスク低い=スコア高い）
        total_risk = sum(r.get("score", 0) for r in basic_risks.values())
        avg_risk = total_risk / len(basic_risks) if basic_risks else 0
        
        # リスクをスコアに変換（0.9リスク → 0.1スコア）
        overall_score = 1.0 - avg_risk
        
        return max(0.1, min(0.99, overall_score))
    
    def _calculate_risk_distribution(self, risk_results: Dict) -> Dict:
        """リスク分布計算"""
        distribution = {}
        basic_risks = risk_results.get("basic_risk", {})
        
        for disease, risk_info in basic_risks.items():
            distribution[disease] = risk_info.get("score", 0)
        
        return distribution
    
    def _extract_top_risks(self, risk_results: Dict) -> List[Tuple]:
        """トップリスク抽出"""
        adjusted_risks = risk_results.get("adjusted_risk", {})
        
        if not adjusted_risks:
            return []
        
        # スコア順にソート
        sorted_risks = sorted(
            adjusted_risks.items(),
            key=lambda x: x[1].get("adjusted_score", 0),
            reverse=True
        )
        
        # 上位5つを返す
        return [(disease, info.get("adjusted_score", 0)) 
                for disease, info in sorted_risks[:5]]
    
    def _generate_recommendations(self, user_data: Dict, risk_results: Dict) -> List[str]:
        """推奨事項生成"""
        recommendations =
        
        
        # リスクに基づく推奨
        top_risks = self._extract_top_risks(risk_results)
        
        for disease, risk_score in top_risks[:3]:  # 上位3つのリスク
            if risk_score >= 0.7:
                rec = f"【要対応】{disease}のリスクが高いです。専門家の相談を推奨します。"
            elif risk_score >= 0.4:
                rec = f"【要注意】{disease}のリスクがあります。生活習慣の改善を推奨します。"
            else:
                rec = f"【良好】{disease}のリスクは低いですが、予防を継続しましょう。"
            recommendations.append(rec)
        
        # 生活習慣に基づく推奨
        lifestyle = user_data.get("lifestyle", {})
        
        if lifestyle.get("exercise_frequency", 0) < 3:
            recommendations.append("運動頻度を週3回以上に増やしましょう。")
        
        if lifestyle.get("sleep_hours", 0) < 7:
            recommendations.append("睡眠時間を7時間以上確保しましょう。")
        
        if lifestyle.get("vegetable_intake") == "少ない":
            recommendations.append("野菜摂取量を増やし、1日350g以上を目指しましょう。")
        
        # 問診データに基づく推奨
        questionnaire = user_data.get("questionnaire", {})
        
        if questionnaire.get("q1"):  # 朝食抜き
            recommendations.append("朝食を必ず摂り、1日3食規則正しく食べましょう。")
        
        if questionnaire.get("q2"):  # 塩辛い物好き
            recommendations.append("塩分控えめ（1日6g未満）を心がけましょう。")
        
        return recommendations
    
    def _summarize_user_data(self, user_data: Dict) -> Dict:
        """ユーザーデータのサマリー作成"""
        summary = {
            "data_collected": [],
            "completeness_score": 0,
            "collection_time": datetime.datetime.now().isoformat()
        }
        
        if user_data.get("questionnaire"):
            summary["data_collected"].append("問診データ（5項目）")
            summary["completeness_score"] += 0.4
        
        if user_data.get("health_check"):
            summary["data_collected"].append("健康診断データ")
            summary["completeness_score"] += 0.3
        
        if user_data.get("lifestyle"):
            summary["data_collected"].append("生活習慣データ")
            summary["completeness_score"] += 0.3
        
        return summary

# ==================== 実行例 ====================

def run_extended_demo():
    """拡張版デモの実行"""
    print("\n" + "="*80)
    print("HealthBook Platform 実用版デモ")
    print("="*80)
    print("このデモでは、拡張された機能を体験できます。")
    print("1. 実際の問診項目形式")
    print("2. 高度なリスク計算")
    print("3. グラフィカルな結果表示")
    print("4. Azure連携（シミュレーション）")
    print("5. レポート生成機能")
    
    engine = HealthBookExtendedEngine()
    
    try:
        # 完全分析の実行
        user_id = input("\nユーザーIDを入力（デフォルト: demo_user）: ").strip()
        if not user_id:
            user_id = "demo_user"
        
        results = engine.run_full_analysis(user_id)
        
        # 結果の詳細表示
        show_detailed_results = input("\n詳細結果を表示しますか？ (はい/いいえ): ").strip().lower()
        if show_detailed_results in ['はい', 'yes', 'y', '1']:
            display_detailed_analysis(results)
        
        print(f"\n✅ 分析が完了しました。")
        print(f"   ユーザーID: {user_id}")
        print(f"   総合スコア: {results.get('overall_score', 0):.1%}")
        print(f"   主要リスク: {len(results.get('top_risks', []))}件")
        
    except KeyboardInterrupt:
        print("\n\nデモを中断しました。")
    except Exception as e:
        print(f"\nエラーが発生しました: {e}")

def display_detailed_analysis(results: Dict):
    """詳細分析結果の表示"""
    print("\n" + "="*80)
    print("詳細分析結果")
    print("="*80)
    
    risk_analysis = results.get("risk_analysis", {})
    
    if "basic_risk" in risk_analysis:
        print("\n📈 基本リスク評価:")
        for disease, info in risk_analysis["basic_risk"].items():
            score = info.get("score", 0)
            matched = info.get("matched_factors", 0)
            total = info.get("total_factors", 1)
            print(f"   • {disease}: {score:.1%} ({matched}/{total}因子)")
    
    if "adjusted_risk" in risk_analysis:
        print("\n🔄 調整後リスク:")
        for disease, info in risk_analysis["adjusted_risk"].items():
            adj_score = info.get("adjusted_score", 0)
            orig_score = info.get("score", 0)
            if adj_score != orig_score:
                change = ((adj_score - orig_score) / orig_score * 100) if orig_score > 0 else 0
                print(f"   • {disease}: {orig_score:.1%} → {adj_score:.1%} ({change:+.1f}%)")
    
    print(f"\n🎯 信頼度スコア: {risk_analysis.get('confidence_score', 0):.1%}")

if __name__ == "__main__":
    run_extended_demo()

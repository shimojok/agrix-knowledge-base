.cycle-canvas-wrap{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:8px;margin-bottom:18px;}

/* FINANCE PAGE */
.fin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px;}

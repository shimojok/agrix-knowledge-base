コード

# 必要なライブラリのインポート
import numpy as np

# 入力データ（仮の数値）
# MBT55による分解時のCO2排出量（kg CO2/t廃棄物）
mbt_co2_emission = 50  
# MBT堆肥による炭素隔離量（腐植質形成、kg C/t廃棄物）
mbt_carbon_sequestration = 200  
# 焼却処理時のCO2排出量（kg CO2/t廃棄物）
incineration_co2_emission = 1000  
# 埋立処理時のCO2排出量（kg CO2/t廃棄物）
landfill_co2_emission = 700  
# 化学肥料製造によるCO2削減効果（kg CO2/t廃棄物に相当する肥料量）
fertilizer_reduction = 150  

# 炭素隔離量をCO2換算に変換（1 kg C = 3.67 kg CO2）
carbon_to_co2_factor = 3.67
mbt_co2_sequestration = mbt_carbon_sequestration * carbon_to_co2_factor

# Net CO2 Balanceの計算
co2_saving_from_treatment = (incineration_co2_emission + landfill_co2_emission) / 2
net_co2_balance = co2_saving_from_treatment - mbt_co2_emission - mbt_co2_sequestration + fertilizer_reduction

# 結果表示
print("MBT55による総合的な二酸化炭素収支:")
print(f"CO2排出削減量: {co2_saving_from_treatment:.2f} kg CO2/t")
print(f"MBT分解時のCO2排出量: {mbt_co2_emission:.2f} kg CO2/t")
print(f"MBT堆肥による炭素隔離量（CO2換算）: {mbt_co2_sequestration:.2f} kg CO2/t")
print(f"化学肥料削減による効果: {fertilizer_reduction:.2f} kg CO2/t")
print(f"Net CO2 Balance: {net_co2_balance:.2f} kg CO2/t")



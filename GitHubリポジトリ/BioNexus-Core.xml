"""Unit tests for M³-BioSynergy simulator"""

import pytest
import numpy as np
from src.core.m3_simulator import M3BioSynergySimulator

class TestM3BioSynergySimulator:
    def test_initialization(self):
        """Test simulator initialization"""
        simulator = M3BioSynergySimulator(species_count=120)
        assert simulator.species_count == 120
        assert len(simulator.species) == 120
        assert simulator.interaction_matrix.shape == (120, 120)
    
    def test_population_dynamics(self):
        """Test basic population dynamics"""
        simulator = M3BioSynergySimulator(species_count=10)  # Smaller for testing
        initial_population = simulator.current_population.copy()
        
        result = simulator.simulate_step(timestep_hours=1.0)
        
        # Population should change
        assert not np.array_equal(result['population'], initial_population)
        
        # No negative populations
        assert np.all(result['population'] >= 0)
    
    def test_carbon_sequestration(self):
        """Test carbon sequestration calculation"""
        simulator = M3BioSynergySimulator(species_count=10)
        result = simulator.simulate_step(timestep_hours=24.0)
        
        # Should have positive carbon sequestration
        assert result['carbon_sequestration_kg'] >= 0
        assert result['total_carbon_sequestered_kg'] >= 0
    
    def test_ecosystem_health_range(self):
        """Test ecosystem health is within 0-100 range"""
        simulator = M3BioSynergySimulator(species_count=10)
        result = simulator.simulate_step()
        
        assert 0 <= result['ecosystem_health'] <= 100
    
    def test_hypercycle_stability(self):
        """Test hypercycle stability assessment"""
        simulator = M3BioSynergySimulator(species_count=10)
        result = simulator.simulate_step()
        
        stability = result['hypercycle_stability']
        assert 'overall_stability' in stability
        assert 'stability_class' in stability
        assert stability['stability_class'] in ['STABLE', 'MODERATE', 'UNSTABLE']

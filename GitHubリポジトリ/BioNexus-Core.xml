    cumulativeIncrease_10yr: number;
    cumulativeIncrease_20yr: number;
    trajectory: 'ACCELERATING' | 'STABLE' | 'DECLINING';
  };
  
  // 目標達成度
  targetComparison: {
    perHeqTarget: number;         // 4per1000目標（%）
    perHeqAchievement: number;    // 達成率（%）
    gapToTarget: number;          // 目標との差（%）
  };
  
  // 診断
  statusMessage: string;
  recommendations: string[];
  confidenceLevel: 'HIGH' | 'MEDIUM' | 'LOW';
  
  calculatedAt: string;
}

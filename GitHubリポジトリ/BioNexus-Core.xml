      responses:
        '200':
          description: Product detail
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ProductDetail'


  ###############################################
  # IMPACT API
  ###############################################

  /impact/scope3:
    get:
      summary: Get Scope 3 reduction data
      responses:
        '200':
          description: Scope 3 data
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Scope3Impact'

  /impact/carbon:
    get:
      summary: Get carbon impact data
      responses:
        '200':
          description: Carbon impact
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CarbonImpact'

  /impact/biosecurity:

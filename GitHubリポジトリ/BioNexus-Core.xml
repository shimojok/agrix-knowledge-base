<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PBPE · BioNexus Holdings v2</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap');
:root {
  --bg:#0D1117; --bg2:#161B22; --bg3:#21262D;
  --border:#30363D; --border2:#3D444D;
  --green:#39D353; --green-dim:#196127; --green-glow:#39D35340;
  --amber:#F0A500; --amber-dim:#7D4E00;
  --blue:#58A6FF; --blue-dim:#1F4A8C;
  --soil:#C9A84C; --red:#F85149; --purple:#BC8CFF; --teal:#3DCFCF;
  --text:#E6EDF3; --text2:#8B949E; --text3:#6E7681;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;font-size:13px;line-height:1.5;min-height:100vh;}

/* TOPBAR */
.topbar{background:var(--bg2);border-bottom:1px solid var(--border);padding:0 24px;height:48px;display:flex;align-items:center;gap:16px;position:sticky;top:0;z-index:200;}
.logo{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:14px;color:var(--green);display:flex;align-items:center;gap:8px;}
.logo-dot{width:8px;height:8px;background:var(--green);border-radius:50%;animation:pdot 2s infinite;}
@keyframes pdot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}
.tabs{display:flex;gap:2px;margin-left:auto;}
.tab{padding:6px 14px;border-radius:6px;color:var(--text2);cursor:pointer;font-size:12px;font-weight:500;transition:all .15s;border:1px solid transparent;}
.tab:hover{background:var(--bg3);color:var(--text);}
.tab.active{background:var(--bg3);color:var(--text);border-color:var(--border);}
.top-badge{background:var(--green);color:#000;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;font-family:'JetBrains Mono',monospace;}
.export-btn{background:var(--bg3);border:1px solid var(--border2);color:var(--text2);font-size:11px;font-weight:600;padding:5px 12px;border-radius:6px;cursor:pointer;font-family:'JetBrains Mono',monospace;transition:all .15s;display:flex;align-items:center;gap:6px;}
.export-btn:hover{background:var(--border);color:var(--text);}

/* LAYOUT */
.layout{display:grid;grid-template-columns:220px 1fr 280px;min-height:calc(100vh - 48px);}

/* SIDEBAR */
.sidebar{border-right:1px solid var(--border);padding:20px 0;background:var(--bg2);}
.sb-sec{padding:0 16px;margin-bottom:22px;}
.sb-lbl{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;margin-bottom:8px;padding:0 4px;}
.sb-item{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;cursor:pointer;color:var(--text2);font-size:12px;font-weight:500;transition:all .15s;margin-bottom:2px;}
.sb-item:hover,.sb-item.active{background:var(--bg3);color:var(--text);}
.sb-icon{width:16px;height:16px;border-radius:3px;display:flex;align-items:center;justify-content:center;font-size:10px;flex-shrink:0;}
.sb-badge{margin-left:auto;background:var(--bg);border:1px solid var(--border);color:var(--text3);font-size:10px;font-family:'JetBrains Mono',monospace;padding:1px 5px;border-radius:8px;}
.sb-div{height:1px;background:var(--border);margin:8px 16px;}

/* PAGES */
.page{display:none;padding:24px;overflow:auto;}
.page.active{display:block;}

/* SHARED */
.page-h1{font-size:20px;font-weight:600;color:var(--text);display:flex;align-items:center;gap:10px;margin-bottom:4px;}
.page-sub{color:var(--text2);font-size:13px;margin-bottom:20px;}
.status-pill{display:inline-flex;align-items:center;gap:6px;background:#1C2A1C;border:1px solid var(--green-dim);color:var(--green);font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;font-family:'JetBrains Mono',monospace;}
.status-pill::before{content:'';width:6px;height:6px;background:var(--green);border-radius:50%;animation:pdot 1.5s infinite;}
.sec-hdr{display:flex;align-items:center;gap:8px;margin-bottom:12px;}
.sec-title{font-size:13px;font-weight:600;color:var(--text);font-family:'JetBrains Mono',monospace;}
.sec-badge{font-size:10px;padding:2px 7px;border-radius:10px;font-weight:600;font-family:'JetBrains Mono',monospace;}
.card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:18px 20px;margin-bottom:18px;}
.card-sm{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:14px;}

/* GATEWAY BANNER */
.gateway{background:linear-gradient(135deg,#0F1F0F,#1A1200,#0A1525);border:1px solid var(--border);border-radius:10px;padding:20px 24px;margin-bottom:18px;position:relative;overflow:hidden;}
.gateway::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--green),var(--amber),var(--blue),var(--green));background-size:200%;animation:shimmer 3s linear infinite;}
@keyframes shimmer{0%{background-position:0%}100%{background-position:200%}}
.gw-eq{display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
.eq-blk{background:var(--bg3);border:1px solid var(--border2);border-radius:8px;padding:10px 16px;text-align:center;}
.eq-lbl{font-size:10px;color:var(--text3);font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.08em;margin-bottom:3px;}
.eq-val{font-size:14px;font-weight:700;font-family:'JetBrains Mono',monospace;}
.eq-sym{font-size:22px;font-weight:700;color:var(--text3);font-family:'JetBrains Mono',monospace;}
.gw-sub{margin-top:10px;font-size:12px;color:var(--text2);}
.gw-sub b{color:var(--text);font-weight:600;}

/* IMPACT CARDS ROW */
.impact-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:18px;}
.ic{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:14px;position:relative;overflow:hidden;}
.ic::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;opacity:.7;}
.ic.food::after{background:var(--green)}.ic.health::after{background:var(--blue)}
.ic.ghg::after{background:var(--teal)}.ic.fin::after{background:var(--amber)}
.ic-lbl{font-size:10px;color:var(--text3);font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.07em;margin-bottom:5px;}
.ic-val{font-size:22px;font-weight:700;font-family:'JetBrains Mono',monospace;line-height:1;margin-bottom:2px;}
.ic.food .ic-val{color:var(--green)}.ic.health .ic-val{color:var(--blue)}
.ic.ghg .ic-val{color:var(--teal)}.ic.fin .ic-val{color:var(--amber)}
.ic-sub{font-size:11px;color:var(--text2);}
.ic-delta{position:absolute;top:10px;right:10px;font-size:10px;font-weight:600;font-family:'JetBrains Mono',monospace;color:var(--green);}

/* CANVAS */
.cv-wrap{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:8px;margin-bottom:18px;}
canvas{display:block;width:100%;cursor:default;}

/* TABLE */
.tbl-wrap{background:var(--bg2);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:18px;}
table{width:100%;border-collapse:collapse;}
thead tr{background:var(--bg3);}
th{padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:var(--text2);font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid var(--border);}
td{padding:10px 14px;font-size:12px;color:var(--text);border-bottom:1px solid var(--border);}
tr:last-child td{border-bottom:none;}
tr:hover td{background:#ffffff06;}
.td-a{font-weight:600;font-family:'JetBrains Mono',monospace;font-size:11px;}
.td-s{color:var(--text2);font-size:11px;}
.pills{display:flex;flex-wrap:wrap;gap:4px;}
.pill{font-size:10px;font-weight:600;padding:2px 7px;border-radius:10px;font-family:'JetBrains Mono',monospace;border:1px solid;}
.p-food{color:var(--green);border-color:var(--green-dim);background:#39D35310;}
.p-ghg{color:var(--teal);border-color:#1A4040;background:#3DCFCF10;}
.p-health{color:var(--blue);border-color:var(--blue-dim);background:#58A6FF10;}
.p-waste{color:var(--soil);border-color:#5A3A00;background:#C9A84C10;}
.p-fin{color:var(--amber);border-color:var(--amber-dim);background:#F0A50010;}
.p-bio{color:var(--purple);border-color:#4A2A7A;background:#BC8CFF10;}

/* MSC ENGINE PAGE */
.msc-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:18px;}
.msc-card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:18px;}
.msc-card h3{font-size:13px;font-weight:600;font-family:'JetBrains Mono',monospace;margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.flow-step{display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;}
.fs-num{width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;font-family:'JetBrains Mono',monospace;flex-shrink:0;margin-top:1px;}
.fs-body .fs-title{font-size:12px;font-weight:600;color:var(--text);margin-bottom:2px;}
.fs-body .fs-sub{font-size:11px;color:var(--text2);}
.fs-arrow{text-align:center;color:var(--text3);font-size:14px;margin:4px 0 4px 32px;}
.bio-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px;}
.bio-card{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:14px;text-align:center;}
.bio-icon{font-size:24px;margin-bottom:6px;}
.bio-title{font-size:11px;font-weight:600;color:var(--text);margin-bottom:4px;}
.bio-val{font-size:18px;font-weight:700;font-family:'JetBrains Mono',monospace;margin-bottom:2px;}
.bio-sub{font-size:10px;color:var(--text2);}
.soil-bars{margin-bottom:18px;}
.bar-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.bar-lbl{font-size:11px;color:var(--text2);width:140px;flex-shrink:0;}
.bar-track{flex:1;height:8px;background:var(--bg3);border-radius:4px;overflow:hidden;}
.bar-fill{height:100%;border-radius:4px;transition:width 2s cubic-bezier(.16,1,.3,1);}
.bar-val{font-size:10px;color:var(--text3);font-family:'JetBrains Mono',monospace;width:45px;text-align:right;}
.cycle-canvas-wrap{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:8px;margin-bottom:18px;}

/* FINANCE PAGE */
.fin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px;}
.fin-card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:16px;}
.fin-card .fc-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
.fin-card .fc-icon{font-size:20px;}
.fin-card .fc-tag{font-size:10px;font-weight:700;font-family:'JetBrains Mono',monospace;padding:2px 8px;border-radius:10px;}
.fin-card h3{font-size:13px;font-weight:700;font-family:'JetBrains Mono',monospace;margin-bottom:4px;}
.fin-card .fc-val{font-size:22px;font-weight:700;font-family:'JetBrains Mono',monospace;margin-bottom:4px;}
.fin-card .fc-sub{font-size:11px;color:var(--text2);margin-bottom:10px;}
.fin-card .fc-item{font-size:11px;color:var(--text2);padding:3px 0;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:6px;}
.fin-card .fc-item:last-child{border-bottom:none;}
.fin-card .fc-item::before{content:'→';color:var(--text3);}
.flow-diagram{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:20px;margin-bottom:18px;}
.fd-row{display:flex;align-items:center;gap:0;margin-bottom:8px;}
.fd-node{background:var(--bg3);border:1px solid var(--border2);border-radius:6px;padding:8px 12px;font-size:11px;font-weight:600;text-align:center;min-width:110px;}
.fd-arrow{flex:1;text-align:center;color:var(--text3);font-size:13px;position:relative;}
.fd-arrow span{position:absolute;top:-14px;left:50%;transform:translateX(-50%);font-size:9px;color:var(--text3);font-family:'JetBrains Mono',monospace;white-space:nowrap;}
.market-table{margin-bottom:18px;}
.mt-row{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid var(--border);background:var(--bg2);}
.mt-row:first-child{background:var(--bg3);border-radius:10px 10px 0 0;}
.mt-row:last-child{border-bottom:none;border-radius:0 0 10px 10px;}
.mt-row.hdr{font-size:10px;font-weight:700;color:var(--text3);font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.07em;}
.mt-market{width:180px;font-size:12px;font-weight:600;}
.mt-size{width:90px;font-size:12px;font-family:'JetBrains Mono',monospace;font-weight:700;}
.mt-bar{flex:1;}
.mt-pbpe{width:100px;font-size:11px;color:var(--green);}

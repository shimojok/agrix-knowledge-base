### マッピング関数の実装例

```typescript
// lib/agrix/module5/mappers/pbpe-mapper.ts

import { Module3Output } from '../../module3/orchestrate/full';
import { Module2Output } from '../../module2/orchestrate/full';

export interface PBPEMetrics {
  foodSecurity: number;      // %
  healthEconomy: number;     // USD（兆）
  ghgReduction: number;      // %
  climateFinance: number;    // USD（兆）
  humusRate: number;         // %
  soilCarbon: number;        // %
  diseaseSuppression: number; // %
  creditValue: number;       // USD
  totalAssetValue: number;   // USD
  riskScore: number;         // 0-100
}

export function mapToPBPEMetrics(
  module2: Module2Output,
  module3: Module3Output
): PBPEMetrics {
  return {
    foodSecurity: module3.simulator?.comparison?.yieldImprovement || 0,
    healthEconomy: (module3.ghgAccounting.reduction.totalReduction * 0.00005) || 0, // 簡易換算
    ghgReduction: module3.ghgAccounting.reduction.reductionRate || 0,
    climateFinance: (module3.sequestration.creditPotential.marketValue / 1e12) || 0, // 兆単位
    humusRate: module2.humus.quality.stabilityIndex * 100 || 0,
    soilCarbon: module3.soc.trend.annualIncrease_percent * 20 || 0,
    diseaseSuppression: module3.prescription?.diagnosis?.currentHealth || 0,
    creditValue: module3.sequestration.creditPotential.marketValue || 0,
    totalAssetValue: module2.economicValue.totalValue || 0,
    riskScore: module3.ghgAccounting.netZero.residualEmissions * 10 || 0,
  };
}
```


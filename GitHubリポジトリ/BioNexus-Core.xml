<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PBPE · BioNexus Holdings</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap');
:root {
  --bg:#0D1117; --bg2:#161B22; --bg3:#21262D; --bg4:#2D333B;
  --border:#30363D; --border2:#3D444D;
  --green:#39D353; --green-dim:#196127; --green-glow:#39D35340;
  --amber:#F0A500; --amber-dim:#7D4E00;
  --blue:#58A6FF; --blue-dim:#1F4A8C;
  --soil:#C9A84C; --red:#F85149; --purple:#BC8CFF; --teal:#3DCFCF;
  --orange:#FF9F43;
  --text:#E6EDF3; --text2:#8B949E; --text3:#6E7681;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;font-size:13px;line-height:1.5;min-height:100vh}

/* TOPBAR */
.topbar{background:var(--bg2);border-bottom:1px solid var(--border);padding:0 20px;height:48px;display:flex;align-items:center;gap:16px;position:sticky;top:0;z-index:200}
.tl{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:13px;color:var(--green);display:flex;align-items:center;gap:8px;white-space:nowrap}
.tl .dot{width:8px;height:8px;background:var(--green);border-radius:50%;animation:pdot 2s infinite}
@keyframes pdot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}
.topbar-tabs{display:flex;gap:2px;margin-left:auto}
.tab{padding:5px 12px;border-radius:6px;color:var(--text2);cursor:pointer;font-size:12px;font-weight:500;border:1px solid transparent;transition:all .15s;white-space:nowrap}
.tab:hover{background:var(--bg3);color:var(--text)}
.tab.active{background:var(--bg3);color:var(--text);border-color:var(--border)}
.tbadge{background:var(--green);color:#000;font-size:10px;font-weight:700;padding:2px 7px;border-radius:10px;font-family:'JetBrains Mono',monospace}

/* EXPORT BTN */
.export-btn{display:flex;align-items:center;gap:6px;padding:5px 12px;border-radius:6px;background:var(--bg3);border:1px solid var(--border2);color:var(--text2);cursor:pointer;font-size:11px;font-weight:600;font-family:'JetBrains Mono',monospace;transition:all .15s;white-space:nowrap}
.export-btn:hover{background:var(--bg4);color:var(--text);border-color:var(--amber)}
.export-dropdown{position:relative}
.export-menu{display:none;position:absolute;top:calc(100% + 4px);right:0;background:var(--bg2);border:1px solid var(--border2);border-radius:8px;padding:6px;z-index:300;min-width:180px;box-shadow:0 8px 24px #00000060}
.export-menu.open{display:block}
.em-item{padding:8px 10px;border-radius:6px;color:var(--text2);cursor:pointer;font-size:12px;display:flex;align-items:center;gap:8px;transition:all .15s}
.em-item:hover{background:var(--bg3);color:var(--text)}
.em-item .ei{font-size:14px}

/* LAYOUT */
.layout{display:grid;grid-template-columns:200px 1fr 260px;min-height:calc(100vh - 48px)}

/* SIDEBAR */
.sidebar{border-right:1px solid var(--border);padding:16px 0;background:var(--bg2);overflow:auto}
.sb-section{padding:0 12px;margin-bottom:20px}
.sb-label{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;margin-bottom:6px;padding:0 4px}
.sb-item{display:flex;align-items:center;gap:7px;padding:5px 7px;border-radius:6px;cursor:pointer;color:var(--text2);font-size:11px;font-weight:500;transition:all .15s;margin-bottom:1px}
.sb-item:hover{background:var(--bg3);color:var(--text)}
.sb-item.active{background:var(--bg3);color:var(--text)}
.sb-icon{width:15px;height:15px;border-radius:3px;display:flex;align-items:center;justify-content:center;font-size:9px;flex-shrink:0}
.sb-cnt{margin-left:auto;background:var(--bg);border:1px solid var(--border);color:var(--text3);font-size:9px;font-family:'JetBrains Mono',monospace;padding:1px 4px;border-radius:8px}
.sb-div{height:1px;background:var(--border);margin:6px 12px}

/* MAIN */
.main{padding:20px;overflow:auto}
.page-view{display:none}
.page-view.active{display:block}

/* HEADERS */
.ph{margin-bottom:20px}
.ph h1{font-size:18px;font-weight:600;display:flex;align-items:center;gap:10px;margin-bottom:4px;flex-wrap:wrap}
.ph p{color:var(--text2);font-size:12px;max-width:640px}
.spill{display:inline-flex;align-items:center;gap:5px;background:#1C2A1C;border:1px solid var(--green-dim);color:var(--green);font-size:10px;font-weight:600;padding:2px 9px;border-radius:20px;font-family:'JetBrains Mono',monospace}
.spill::before{content:'';width:5px;height:5px;background:var(--green);border-radius:50%;animation:pdot 1.5s infinite}

.sh{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.st{font-size:12px;font-weight:600;font-family:'JetBrains Mono',monospace}
.sbadge{font-size:10px;padding:2px 6px;border-radius:8px;font-weight:600;font-family:'JetBrains Mono',monospace}

/* GATEWAY BANNER */
.gw-banner{background:linear-gradient(135deg,#0F1F0F,#1A1200,#0A1525);border:1px solid var(--border);border-radius:10px;padding:18px 20px;margin-bottom:18px;position:relative;overflow:hidden}
.gw-banner::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--green),var(--amber),var(--blue),var(--green));background-size:200%;animation:shimmer 3s linear infinite}
@keyframes shimmer{0%{background-position:0%}100%{background-position:200%}}
.gw-eq{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.eq-b{background:var(--bg3);border:1px solid var(--border2);border-radius:7px;padding:10px 14px;text-align:center}
.eq-b .ebl{font-size:9px;color:var(--text3);font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.07em;margin-bottom:3px}
.eq-b .ebv{font-size:13px;font-weight:700;font-family:'JetBrains Mono',monospace}
.eq-b.gw .ebv{color:var(--green)}
.eq-b.eng .ebv{color:var(--amber)}
.eq-sym{font-size:20px;font-weight:700;color:var(--text3);font-family:'JetBrains Mono',monospace}
.gw-sub{margin-top:10px;font-size:11px;color:var(--text2)}
.gw-sub span{color:var(--text);font-weight:500}

/* IMPACT CARDS */
.ic-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:18px}
.ic{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:12px;position:relative;overflow:hidden}
.ic::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;opacity:.7}
.ic.food::after{background:var(--green)}.ic.health::after{background:var(--blue)}.ic.ghg::after{background:var(--teal)}.ic.fin::after{background:var(--amber)}
.ic .icl{font-size:9px;color:var(--text3);font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.07em;margin-bottom:5px}
.ic .icv{font-size:20px;font-weight:700;font-family:'JetBrains Mono',monospace;line-height:1;margin-bottom:2px}
.ic.food .icv{color:var(--green)}.ic.health .icv{color:var(--blue)}.ic.ghg .icv{color:var(--teal)}.ic.fin .icv{color:var(--amber)}
.ic .ics{font-size:10px;color:var(--text2)}
.ic .icd{position:absolute;top:10px;right:10px;font-size:9px;font-weight:600;font-family:'JetBrains Mono',monospace;color:var(--green)}

/* CANVAS */
.cw{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:6px;margin-bottom:18px}
canvas{display:block;width:100%}

/* MSC FLOW */
.msc-flow{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:16px 18px;margin-bottom:18px}
.msc-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:0;align-items:center;margin-top:12px}
.mn{background:var(--bg3);border:1px solid var(--border2);border-radius:7px;padding:10px 8px;text-align:center}
.mn .mni{font-size:18px;margin-bottom:3px}
.mn .mnt{font-size:10px;font-weight:600;color:var(--text);margin-bottom:2px}
.mn .mns{font-size:9px;color:var(--text3);font-family:'JetBrains Mono',monospace}
.ma{text-align:center;color:var(--text3);font-size:16px;padding:0 2px}
.mn.center{background:linear-gradient(135deg,#1A2A0A,#2A1A00);border-color:var(--amber);box-shadow:0 0 14px #F0A50020}
.mn.center .mnt{color:var(--amber);font-size:11px}

/* TABLE */
.tw{background:var(--bg2);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:18px}
table{width:100%;border-collapse:collapse}
thead tr{background:var(--bg3)}
th{padding:8px 12px;text-align:left;font-size:10px;font-weight:600;color:var(--text2);font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid var(--border)}
td{padding:9px 12px;font-size:11px;color:var(--text);border-bottom:1px solid var(--border)}
tr:last-child td{border-bottom:none}
tr:hover td{background:#FFFFFF05}
.ta{font-weight:600;font-family:'JetBrains Mono',monospace;font-size:10px}
.ti{color:var(--text2);font-size:10px}
.td-s{display:flex;flex-wrap:wrap;gap:3px}
.sp{font-size:9px;font-weight:600;padding:2px 6px;border-radius:8px;font-family:'JetBrains Mono',monospace;border:1px solid}
.sp-food{color:var(--green);border-color:var(--green-dim);background:#39D35310}
.sp-ghg{color:var(--teal);border-color:#1A4040;background:#3DCFCF10}
.sp-health{color:var(--blue);border-color:var(--blue-dim);background:#58A6FF10}
.sp-waste{color:var(--soil);border-color:#5A3A00;background:#C9A84C10}
.sp-fin{color:var(--amber);border-color:var(--amber-dim);background:#F0A50010}
.sp-bio{color:var(--purple);border-color:#4A2A7A;background:#BC8CFF10}

/* ── MSC ENGINE TAB ── */
.engine-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px}
.eng-card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:16px}

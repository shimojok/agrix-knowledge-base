      "type": "object",
      "properties": {
        "polyphenolDensity": { "type": "number" },
        "metabolicLifeDays": { "type": "number" }
      },
      "required": ["polyphenolDensity", "metabolicLifeDays"]
    },

    "pricing": {
      "type": "object",
      "properties": {
        "pMarket": { "type": "number" },
        "V": { "type": "number" },
        "L": { "type": "number" },
        "m": { "type": "number" },
        "C": { "type": "number" },
        "pTotal": { "type": "number" }
      },
      "required": ["pMarket", "V", "L", "m", "C", "pTotal"]
    },

    "signature": {
      "type": "object",
      "properties": {
        "hash": { "type": "string" },
        "algorithm": { "type": "string" }
      },

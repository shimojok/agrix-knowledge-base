.ph p{color:var(--text2);font-size:12px;max-width:640px}
.spill{display:inline-flex;align-items:center;gap:5px;background:#1C2A1C;border:1px solid var(--green-dim);color:var(--green);font-size:10px;font-weight:600;padding:2px 9px;border-radius:20px;font-family:'JetBrains Mono',monospace}
.spill::before{content:'';width:5px;height:5px;background:var(--green);border-radius:50%;animation:pdot 1.5s infinite}


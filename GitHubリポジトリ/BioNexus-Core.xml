        if participant_id in self.trial_data:
            self.trial_data[participant_id]["interventions"].append({
                **intervention,
                "timestamp": datetime.now().isoformat()
            })
    
    def record_outcome(self, participant_id: str, outcome_type: str, data: Dict):
        """結果を記録"""
        if participant_id in self.trial_data:

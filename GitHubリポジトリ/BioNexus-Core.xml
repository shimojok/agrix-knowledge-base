        base_scores = {
            "organic": 1.2,
            "regenerative": 1.5,
            "conventional": 1.0,
            "hydroponic": 0.8
        }
        
        base_score = base_scores.get(cultivation_method, 1.0)
        
        # 食材固有の補正
        food_factors = {

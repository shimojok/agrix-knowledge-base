class MetabolicVectorizer:

    def __init__(self, questionnaire):
        self.q = questionnaire

    def vectorize(self, answers):
        vector = {
            "glucose": 0,
            "lipid": 0,
            "inflammation": 0,
            "gut": 0,
            "hormone": 0
        }

        for q_id, ans in answers.items():
            meta = self.q[q_id]["metabolic_impact"]

            if "血糖" in meta:
                vector["glucose"] += ans
            if "脂質" in meta:
                vector["lipid"] += ans
            if "炎症" in meta:
                vector["inflammation"] += ans
            if "腸内" in meta:
                vector["gut"] += ans
            if "ホルモン" in meta:
                vector["hormone"] += ans

        return vector
```


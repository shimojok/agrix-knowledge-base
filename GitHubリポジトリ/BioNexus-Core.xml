// app/api/agrix/module5/orchestrate/route.ts

import { NextRequest, NextResponse } from 'next/server';
import { runModule5Full } from '@/lib/agrix/module5';

export async function POST(req: NextRequest) {
  try {
    const body = await req.json();
    
    // 必須フィールドチェック
    const requiredFields = [
      'module1', 'module2', 'module3',
      'safetyChainRequest', 'pbpeRequest',
      'insuranceRequest', 'governmentRequest', 'microsoftRequest'
    ];
    for (const field of requiredFields) {
      if (!body[field]) {
        return NextResponse.json(
          { error: `Missing required field: ${field}` },
          { status: 400 }
        );
      }
    }

    const result = runModule5Full(body);

    return NextResponse.json(result);
  } catch (error) {
    return NextResponse.json(
      { error: 'Internal server error', details: String(error) },
      { status: 500 }
    );
  }
}

// 個別ゲートウェイエンドポイント
export async function GET(req: NextRequest) {
  const { searchParams } = new URL(req.url);
  const gateway = searchParams.get('gateway');
  
  // 簡易実装：各ゲートウェイへのルーティング
  if (gateway === 'safetychain') {
    // SafetyChain証明書取得
    return NextResponse.json({ message: 'SafetyChain Gateway', available: true });
  }
  if (gateway === 'pbpe') {
    return NextResponse.json({ message: 'PBPE Gateway', available: true });
  }
  if (gateway === 'insurance') {
    return NextResponse.json({ message: 'Insurance Gateway', available: true });
  }
  if (gateway === 'government') {
    return NextResponse.json({ message: 'Government Gateway', available: true });
  }
  if (gateway === 'microsoft') {
    return NextResponse.json({ message: 'Microsoft Gateway', available: true });
  }

  return NextResponse.json({
    gateways: ['safetychain', 'pbpe', 'insurance', 'government', 'microsoft']
  });
}

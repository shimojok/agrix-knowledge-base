        <div class="slide-kpis">
          <div class="sk"><div class="sk-val" style="color:var(--amber)">$850B</div><div class="sk-label">解放市場規模</div></div>
          <div class="sk"><div class="sk-val" style="color:var(--amber)">4-6%</div><div class="sk-label">ACIB債利回り</div></div>

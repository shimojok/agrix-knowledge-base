// lib/agrix/module5/orchestrate/full.ts

import { Module1Output } from '../../module1/orchestrate/full';
import { Module2Output } from '../../module2/orchestrate/full';
import { Module3Output } from '../../module3/orchestrate/full';
import { generateSafetyChainGateway } from '../engines/safetychain.gateway';
import { generatePBPEGateway } from '../engines/pbpe.gateway';
import { generateInsuranceGateway } from '../engines/insurance.gateway';
import { generateGovernmentGateway } from '../engines/government.gateway';
import { generateMicrosoftGateway } from '../engines/microsoft.gateway';

export interface Module5Input {
  // Module1/2/3の出力
  module1: Module1Output;
  module2: Module2Output;
  module3: Module3Output;
  
  // 各ゲートウェイのリクエスト
  safetyChainRequest: {
    lotId: string;
    includeBlockchain?: boolean;
    language?: 'ja' | 'en' | 'zh' | 'ko';
  };
  pbpeRequest: {
    assetId: string;
    includeTradingData?: boolean;
    includeCarbonCredits?: boolean;
    currency?: 'USD' | 'EUR' | 'JPY';
  };
  insuranceRequest: {
    farmId: string;
    cropType: string;
    areaHa: number;
    coverageType: 'BASIC' | 'STANDARD' | 'PREMIUM';
    includeMitigation?: boolean;
  };
  governmentRequest: {
    farmId: string;
    year: number;
    format?: 'CSV' | 'PDF' | 'JSON' | 'XML';
    language?: 'ja' | 'en';
    includeSDGs?: boolean;
    includeMRV?: boolean;
  };
  microsoftRequest: {
    tenantId: string;
    farmId: string;
    eventType: 'SOIL_DATA' | 'AGENT_OUTPUT' | 'CERTIFICATE' | 'PRICING';
    includeDataLake?: boolean;
    includeAPIManagement?: boolean;
  };
}

export interface Module5Output {
  timestamp: string;
  version: string;
  
  // 各ゲートウェイ出力
  safetychain: any;
  pbpe: any;
  insurance: any;
  government: any;
  microsoft: any;
  
  // 集約サマリ
  summary: {
    gatewayStatus: {
      safetychain: 'READY' | 'ERROR';
      pbpe: 'READY' | 'ERROR';
      insurance: 'READY' | 'ERROR';
      government: 'READY' | 'ERROR';
      microsoft: 'READY' | 'ERROR';
    };
    totalOutputs: number;
    generatedAt: string;
  };
}

export function runModule5Full(input: Module5Input): Module5Output {
  const {
    module1,
    module2,
    module3,
    safetyChainRequest,
    pbpeRequest,
    insuranceRequest,
    governmentRequest,
    microsoftRequest
  } = input;

  // 各ゲートウェイ実行
  const safetychain = generateSafetyChainGateway(module1, module2, module3, safetyChainRequest);
  const pbpe = generatePBPEGateway(module1, module2, module3, pbpeRequest);
  const insurance = generateInsuranceGateway(module1, module3, insuranceRequest);
  const government = generateGovernmentGateway(module1, module3, governmentRequest);
  const microsoft = generateMicrosoftGateway(module1, module2, module3, microsoftRequest);

  return {
    timestamp: new Date().toISOString(),
    version: '1.0.0',
    safetychain,
    pbpe,
    insurance,
    government,
    microsoft,
    summary: {
      gatewayStatus: {
        safetychain: 'READY',
        pbpe: 'READY',
        insurance: 'READY',
        government: 'READY',
        microsoft: 'READY'
      },
      totalOutputs: 5,
      generatedAt: new Date().toISOString()
    }
  };
}

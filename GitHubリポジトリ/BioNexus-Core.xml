@keyframes pdot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}
.topbar-tabs{display:flex;gap:2px;margin-left:auto}
.tab{padding:5px 12px;border-radius:6px;color:var(--text2);cursor:pointer;font-size:12px;font-weight:500;border:1px solid transparent;transition:all .15s;white-space:nowrap}
.tab:hover{background:var(--bg3);color:var(--text)}
.tab.active{background:var(--bg3);color:var(--text);border-color:var(--border)}
.tbadge{background:var(--green);color:#000;font-size:10px;font-weight:700;padding:2px 7px;border-radius:10px;font-family:'JetBrains Mono',monospace}

/* EXPORT BTN */
.export-btn{display:flex;align-items:center;gap:6px;padding:5px 12px;border-radius:6px;background:var(--bg3);border:1px solid var(--border2);color:var(--text2);cursor:pointer;font-size:11px;font-weight:600;font-family:'JetBrains Mono',monospace;transition:all .15s;white-space:nowrap}
.export-btn:hover{background:var(--bg4);color:var(--text);border-color:var(--amber)}
.export-dropdown{position:relative}
.export-menu{display:none;position:absolute;top:calc(100% + 4px);right:0;background:var(--bg2);border:1px solid var(--border2);border-radius:8px;padding:6px;z-index:300;min-width:180px;box-shadow:0 8px 24px #00000060}
.export-menu.open{display:block}
.em-item{padding:8px 10px;border-radius:6px;color:var(--text2);cursor:pointer;font-size:12px;display:flex;align-items:center;gap:8px;transition:all .15s}
.em-item:hover{background:var(--bg3);color:var(--text)}
.em-item .ei{font-size:14px}

/* LAYOUT */
.layout{display:grid;grid-template-columns:200px 1fr 260px;min-height:calc(100vh - 48px)}

/* SIDEBAR */
.sidebar{border-right:1px solid var(--border);padding:16px 0;background:var(--bg2);overflow:auto}
.sb-section{padding:0 12px;margin-bottom:20px}
.sb-label{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;margin-bottom:6px;padding:0 4px}
.sb-item{display:flex;align-items:center;gap:7px;padding:5px 7px;border-radius:6px;cursor:pointer;color:var(--text2);font-size:11px;font-weight:500;transition:all .15s;margin-bottom:1px}
.sb-item:hover{background:var(--bg3);color:var(--text)}
.sb-item.active{background:var(--bg3);color:var(--text)}
.sb-icon{width:15px;height:15px;border-radius:3px;display:flex;align-items:center;justify-content:center;font-size:9px;flex-shrink:0}
.sb-cnt{margin-left:auto;background:var(--bg);border:1px solid var(--border);color:var(--text3);font-size:9px;font-family:'JetBrains Mono',monospace;padding:1px 4px;border-radius:8px}
.sb-div{height:1px;background:var(--border);margin:6px 12px}

/* MAIN */

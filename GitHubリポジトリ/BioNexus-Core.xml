```python
from __future__ import annotations

import json
from pathlib import Path
from typing import Dict


PATHWAYS = [
    "PATH_00",
    "PATH_01",
    "PATH_02",
    "PATH_03",
    "PATH_04",
    "PATH_05",
    "PATH_06",
]


class PhenotypeEngine:
    def __init__(self, matrix_path: str | Path):
        self.matrix_path = Path(matrix_path)

        if not self.matrix_path.exists():
            raise FileNotFoundError(
                f"Questionnaire matrix not found: {self.matrix_path}"
            )

        with open(self.matrix_path, "r", encoding="utf-8") as f:
            self.matrix = json.load(f)

    def calculate_scores(
        self,
        answers: Dict[str, float]
    ) -> Dict[str, float]:

        scores = {pathway: 0.0 for pathway in PATHWAYS}

        for qid, answer_value in answers.items():

            if qid not in self.matrix:
                continue

            weights = self.matrix[qid].get("weights", {})

            for pathway, weight in weights.items():

                if pathway not in scores:
                    continue

                scores[pathway] += float(answer_value) * float(weight)

        normalized_scores = self._normalize_scores(scores)

        return normalized_scores

    @staticmethod
    def _normalize_scores(
        scores: Dict[str, float]
    ) -> Dict[str, float]:

        normalized = {}

        for pathway, value in scores.items():

            adjusted = 0.5 + value

            adjusted = max(0.0, min(1.0, adjusted))

            normalized[pathway] = round(adjusted, 2)

        return normalized
```


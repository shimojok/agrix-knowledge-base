/* PRINT TARGET */
#print-target{position:fixed;left:-9999px;top:0;width:1200px;background:#0D1117;padding:40px;font-family:'Inter',sans-serif}
.pt-page{page-break-after:always;padding-bottom:40px;border-bottom:1px solid #30363D;margin-bottom:40px}


// lib/agrix/module2/orchestrate/full.ts

import { SoilSensorInput } from '../../module1/types/mbt55.types';
import { HypercycleOutput } from '../../module1/types/hypercycle.types';
import { runHumusEngine } from '../engines/humus.engine';
import { runFertilizerEngine } from '../engines/fertilizer.engine';
import { runFeedEngine } from '../engines/feed.engine';
import { HumusInput, FertilizerInput, FeedInput } from '../types';

export interface Module2Input {
  // Module1の出力
  hypercycle: HypercycleOutput;
  soilData: SoilSensorInput;
  decomposerActivity: any;
  
  // 生産設定
  productionConfig: {
    // 腐植質設定
    humus: {
      inputBiomass_tPerHa: number;
      retentionDays: number;
      turningFrequency: number;
      moistureTarget: number;
    };
    // 発酵肥料設定
    fertilizer: {
      type: 'LIQUID' | 'SOLID' | 'BOTH';
      inputMaterial: 'CROP_RESIDUE' | 'MANURE' | 'FOOD_WASTE' | 'MIXED';
      fermentationDays: number;
      aerationRate: number;
      temperatureTarget: number;
      phTarget: number;
    };
    // 発酵飼料設定
    feed: {
      livestockType: 'RUMINANT' | 'PIG' | 'POULTRY' | 'AQUACULTURE';
      feedBase: 'SILAGE' | 'HAY' | 'GRAIN' | 'MIXED';
      fermentationDays: number;
      inoculationRate: number;
      moistureTarget: number;
      compactionDensity: number;
    };
  };
  
  // 原料組成
  feedStock: {
    carbonSource: number;
    nitrogenSource: number;
    mineralContent: number;
    moistureContent: number;
    crudeProtein: number;
    crudeFiber: number;
    starch: number;
    fat: number;
    ash: number;
  };
}

export interface Module2Output {
  timestamp: string;
  version: string;
  
  // 3資材の個別出力
  humus: HumusOutput;
  fertilizer: FertilizerOutput;
  feed: FeedOutput;
  
  // 統合MSCスコア
  mscIntegratedScore: number;        // 0-100
  mscStatus: 'OPTIMAL' | 'GOOD' | 'FAIR' | 'POOR';
  
  // 資源循環効率
  circularEconomy: {
    resourceRecoveryRate: number;     // 0-1 資源回収率
    wasteReductionRate: number;       // 0-1 廃棄物削減率
    nutrientLoopEfficiency: number;   // 0-1 栄養ループ効率
  };
  
  // Module3（炭素・GHG）への連携データ
  toModule3: {
    totalCarbonSequestration: number; // tCO2/ha（腐植質由来）
    methaneReduction: number;         // tCO2/年（発酵飼料由来）
    ghgReductionTotal: number;        // tCO2/ha/yr（総合）
    socIncreaseTotal: number;         // t/ha（総合SOC増加）
  };
  
  // 経済価値サマリ
  economicValue: {
    humusValue: number;               // USD/ha（腐植質価値）
    fertilizerValue: number;          // USD/ha（肥料価値）
    feedValue: number;                // USD/ha（飼料価値）
    carbonCreditValue: number;        // USD/ha（炭素クレジット価値）
    totalValue: number;               // USD/ha（総合価値）
  };
  
  summary: {
    recommendedAction: string;
    priorityActions: string[];
  };
}

export function runModule2Full(input: Module2Input): Module2Output {
  // ----- 1. 各資材エンジン実行 -----
  const humusInput: HumusInput = {
    hypercycle: input.hypercycle,
    soilData: input.soilData,
    productionConfig: input.productionConfig.humus,
  };
  const humus = runHumusEngine(humusInput);
  
  const fertilizerInput: FertilizerInput = {
    hypercycle: input.hypercycle,
    soilData: input.soilData,
    decomposerActivity: input.decomposerActivity,
    productionConfig: input.productionConfig.fertilizer,
    feedStock: {
      carbonSource: input.feedStock.carbonSource,
      nitrogenSource: input.feedStock.nitrogenSource,
      mineralContent: input.feedStock.mineralContent,
      moistureContent: input.feedStock.moistureContent,
    },
  };
  const fertilizer = runFertilizerEngine(fertilizerInput);
  
  const feedInput: FeedInput = {
    hypercycle: input.hypercycle,
    soilData: input.soilData,
    decomposerActivity: input.decomposerActivity,
    productionConfig: input.productionConfig.feed,
    feedStock: {
      crudeProtein: input.feedStock.crudeProtein,
      crudeFiber: input.feedStock.crudeFiber,
      starch: input.feedStock.starch,
      fat: input.feedStock.fat,
      ash: input.feedStock.ash,
    },
  };
  const feed = runFeedEngine(feedInput);

  // ----- 2. 統合MSCスコア計算 -----
  const mscIntegratedScore = (
    humus.quality.stabilityIndex * 0.25 +
    humus.production.productionEfficiency * 0.15 +
    fertilizer.production.productionEfficiency * 0.20 +
    fertilizer.cascadeEffect.nutrientUseEfficiency * 0.15 +
    feed.production.fermentationQuality * 0.15 +
    feed.methaneReduction.totalMethaneReduction / 100 * 0.10
  ) * 100;

  let mscStatus: Module2Output['mscStatus'] = 'FAIR';
  if (mscIntegratedScore >= 80) mscStatus = 'OPTIMAL';
  else if (mscIntegratedScore >= 65) mscStatus = 'GOOD';
  else if (mscIntegratedScore >= 45) mscStatus = 'FAIR';
  else mscStatus = 'POOR';

  // ----- 3. 資源循環効率 -----
  const resourceRecoveryRate = (
    humus.production.yieldRate / 100 * 0.4 +
    fertilizer.production.productionEfficiency * 0.3 +
    feed.production.dryMatterRecovery / 100 * 0.3
  );
  
  const wasteReductionRate = Math.min(1,
    (humus.production.productionEfficiency * 0.4 +
     fertilizer.production.fermentationCompletion * 0.3 +
     feed.production.dryMatterRecovery / 100 * 0.3)
  );
  
  const nutrientLoopEfficiency = (
    humus.soilImpact.nutrientRetention * 0.35 +
    fertilizer.cascadeEffect.nutrientUseEfficiency * 0.35 +
    feed.nutritionalValue.digestibility / 100 * 0.30
  );

  // ----- 4. Module3連携データ -----
  const totalCarbonSequestration = humus.soilImpact.carbonSequestration;
  const methaneReduction = feed.methaneReduction.co2EquivalentReduction * 0.5;
  const ghgReductionTotal = totalCarbonSequestration + methaneReduction;
  const socIncreaseTotal = humus.soilImpact.socIncrease;

  // ----- 5. 経済価値算定（簡易） -----
  const humusValue = humus.production.outputHumus_tPerHa * 50; // USD/t
  const fertilizerValue = (
    fertilizer.production.liquidVolume_L * 0.5 +
    fertilizer.production.solidWeight_kg * 0.3
  );
  const feedValue = feed.production.output_tPerHa * 80; // USD/t
  const carbonCreditValue = totalCarbonSequestration * 15; // USD/tCO2
  
  const totalValue = humusValue + fertilizerValue + feedValue + carbonCreditValue;

  // ----- 6. サマリ生成 -----
  const summary = generateModule2Summary(mscIntegratedScore, mscStatus, humus, fertilizer, feed);

  return {
    timestamp: new Date().toISOString(),
    version: '1.0.0',
    humus,
    fertilizer,
    feed,
    mscIntegratedScore: Number(mscIntegratedScore.toFixed(1)),
    mscStatus,
    circularEconomy: {
      resourceRecoveryRate: Number(Math.min(1, resourceRecoveryRate).toFixed(3)),
      wasteReductionRate: Number(Math.min(1, wasteReductionRate).toFixed(3)),
      nutrientLoopEfficiency: Number(Math.min(1, nutrientLoopEfficiency).toFixed(3)),
    },
    toModule3: {
      totalCarbonSequestration: Number(totalCarbonSequestration.toFixed(2)),
      methaneReduction: Number(methaneReduction.toFixed(2)),
      ghgReductionTotal: Number(ghgReductionTotal.toFixed(2)),
      socIncreaseTotal: Number(socIncreaseTotal.toFixed(2)),
    },
    economicValue: {
      humusValue: Number(humusValue.toFixed(0)),
      fertilizerValue: Number(fertilizerValue.toFixed(0)),
      feedValue: Number(feedValue.toFixed(0)),
      carbonCreditValue: Number(carbonCreditValue.toFixed(0)),
      totalValue: Number(totalValue.toFixed(0)),
    },
    summary,
  };
}

function generateModule2Summary(score: number, status: string, humus: any, fertilizer: any, feed: any): Module2Output['summary'] {
  let recommendedAction = '';
  const priorityActions: string[] = [];

  if (status === 'OPTIMAL') {
    recommendedAction = '✅ MSC（MBT Sustainable Cycle）が最適化されています。3資材の生産を継続し、炭素隔離・GHG削減効果を最大化してください。';
    priorityActions.push('腐植質の継続生産でSOC増加を維持');
    priorityActions.push('発酵肥料の施用で収量向上を継続');
    priorityActions.push('発酵飼料でメタン削減効果を維持');
  } else if (status === 'GOOD') {
    recommendedAction = '📈 MSCは良好です。一部の資材で品質向上の余地があります。';
    if (humus.qualityGrade !== 'A') priorityActions.push('腐植質の品質向上（腐熟期間延長）');
    if (fertilizer.qualityGrade !== 'A') priorityActions.push('発酵肥料の栄養バランス改善');
    if (feed.qualityGrade !== 'A') priorityActions.push('発酵飼料の品質向上（接種率増加）');
  } else {
    recommendedAction = '⚠️ MSCが最適化されていません。各資材の生産プロセスを見直してください。';
    if (humus.qualityGrade === 'C' || humus.qualityGrade === 'D') {
      priorityActions.push('腐植質の生産条件（バイオマス投入量・腐熟期間）を再評価');
    }
    if (fertilizer.qualityGrade === 'C' || fertilizer.qualityGrade === 'D') {
      priorityActions.push('発酵肥料の原料配合・発酵環境を改善');
    }
    if (feed.qualityGrade === 'C' || feed.qualityGrade === 'D') {
      priorityActions.push('発酵飼料の接種率・発酵期間を増加');
    }
  }

  return {
    recommendedAction,
    priorityActions: priorityActions.length > 0 ? priorityActions : ['現状のMSC運用を継続してください。'],
  };
}

.eq-val{font-size:14px;font-weight:700;font-family:'JetBrains Mono',monospace;}
.eq-sym{font-size:22px;font-weight:700;color:var(--text3);font-family:'JetBrains Mono',monospace;}
.gw-sub{margin-top:10px;font-size:12px;color:var(--text2);}

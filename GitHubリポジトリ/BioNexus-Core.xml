import { GovernmentGatewayOutput, GovernmentRequest } from '../types/government-gateway.types';
import { Module1Output } from '../../module1/orchestrate/full';
import { Module3Output } from '../../module3/orchestrate/full';

/**
 * 政府機関向けGateway
 * MRV報告・SDGs貢献データを生成
 */
export function generateGovernmentGateway(
  module1: Module1Output,
  module3: Module3Output,
  request: GovernmentRequest
): GovernmentGatewayOutput {
  const { farmId, year, format = 'JSON', language = 'ja', includeSDGs = true, includeMRV = true } = request;

  // --- MRVデータ ---
  const baselineEmissions = module3.ghgAccounting.scopeEmissions.total.grossEmissions * 1.5;
  const actualSequestration = module3.sequestration.stableCarbon.totalSequestration_tCO2;
  const emissionsReduction = module3.ghgAccounting.reduction.totalReduction;
  const netReduction = Math.max(0, emissionsReduction - baselineEmissions * 0.1);

  const additionalityScore = Math.min(1, (actualSequestration - baselineEmissions * 0.2) / (actualSequestration + 0.01));

  const verificationStatus = actualSequestration > 10 ? 'VERIFIED' : 'PENDING';

  // --- SDGs貢献 ---
  const sdg2Contribution = Math.min(100, 40 + 30 * module1.hypercycle.cycleEfficiency + 20 * (module3.soc.trend.annualIncrease_tPerHa / 0.3));
  const sdg12Contribution = Math.min(100, 30 + 40 * module1.hypercycle.cycleEfficiency + 20 * module1.biocontrol.biocontrolEfficacy);
  const sdg13Contribution = Math.min(100, 20 + 40 * (module3.sequestration.stableCarbon.permanenceScore) + 30 * (module3.soc.trend.annualIncrease_tPerHa / 0.3));
  const sdg15Contribution = Math.min(100, 30 + 30 * module1.biosecurity.biomeResilienceScore + 30 * module1.hypercycle.humificationRate);

  // --- 国家貢献 ---
  const ghgReductionTarget = 26; // 日本のNDC目標（例）
  const achievedReduction = (module3.ghgAccounting.reduction.reductionRate);
  const targetAchievementRate = Math.min(100, (achievedReduction / ghgReductionTarget) * 100);

  // --- 報告書 ---
  const keyMetrics = [
    { name: 'GHG削減量', value: module3.ghgAccounting.reduction.totalReduction, unit: 'tCO2', target: 10, status: module3.ghgAccounting.reduction.totalReduction > 10 ? 'ON_TRACK' : 'NEEDS_ATTENTION' as const },
    { name: 'SOC増加量', value: module3.soc.trend.annualIncrease_tPerHa, unit: 't/ha', target: 0.3, status: module3.soc.trend.annualIncrease_tPerHa > 0.2 ? 'ON_TRACK' : 'NEEDS_ATTENTION' as const },
    { name: '炭素隔離量', value: module3.sequestration.stableCarbon.annualSequestration_tCO2, unit: 'tCO2/ha', target: 5, status: module3.sequestration.stableCarbon.annualSequestration_tCO2 > 3 ? 'ON_TRACK' : 'NEEDS_ATTENTION' as const },
  ];

  // 言語対応
  const textMap = {
    ja: {
      ndcContribution: '日本のNDC目標（26%削減）に対して、現在の削減率は{achieved}%です。目標達成率は{target}%です。',
      summary: '本報告書は、AGRIX SystemによるGHG削減・炭素隔離の実績をMRVフレームワークに基づいて報告します。'
    },
    en: {
      ndcContribution: 'Against Japan\'s NDC target (26% reduction), current reduction rate is {achieved}%. Target achievement rate is {target}%.',
      summary: 'This report presents GHG reduction and carbon sequestration performance by AGRIX System under MRV framework.'
    }
  };

  const lang = language as 'ja' | 'en';
  const texts = textMap[lang] || textMap.ja;

  const ndcContribution = texts.ndcContribution
    .replace('{achieved}', achievedReduction.toFixed(1))
    .replace('{target}', targetAchievementRate.toFixed(1));

  return {
    mrv: {
      reportId: `MRV-${farmId}-${year}`,
      reportingPeriod: {
        start: `${year}-01-01`,
        end: `${year}-12-31`
      },
      baseline: {
        emissions: Number(baselineEmissions.toFixed(2)),
        methodology: 'AGRIX MRV Methodology v1.0 - IPCC Tier 2 準拠',
        referenceYear: 2020
      },
      actual: {
        sequestration: Number(actualSequestration.toFixed(2)),
        emissionsReduction: Number(emissionsReduction.toFixed(2)),
        netReduction: Number(netReduction.toFixed(2))
      },
      additionality: {
        score: Number(additionalityScore.toFixed(3)),
        assessment: additionalityScore > 0.6 ? '追加性が認められます' : '追加性の評価にはさらなるデータが必要です',
        barriers: ['技術普及の障壁', '初期投資コスト', '知識・スキルの不足']
      },
      verification: {
        status: verificationStatus as 'PENDING' | 'IN_PROGRESS' | 'VERIFIED' | 'CERTIFIED',
        nextVerificationDate: new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString(),
        documents: ['現場測定データ', 'ラボ分析結果', '施用記録']
      }
    },
    sdgs: {
      sdg2: {
        contribution: Number(sdg2Contribution.toFixed(0)),
        target: 'SDG 2.4: 持続可能な食料生産システムの確保',
        progress: sdg2Contribution > 70 ? '順調に進捗' : '改善の余地あり'
      },
      sdg12: {
        contribution: Number(sdg12Contribution.toFixed(0)),
        target: 'SDG 12.2: 天然資源の持続可能な管理',

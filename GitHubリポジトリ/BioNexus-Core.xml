    roi = (npv / results['economic_analysis']['initial_investment']) * 100
    payback = results['economic_analysis']['initial_investment'] / annual_net_cashflow
    
    sensitivity_data.append({
        '炭素価格 (円/tCO₂e)': carbon_price,
        '炭素クレジット収入 (兆円/年)': round(carbon_revenue / 1e12, 1),
        '投資利益率 (ROI)': f"{roi:.1f}%",
        '回収期間 (年)': f"{payback:.1f}",
        'プロジェクトNPV (兆円)': f"{npv/1e12:.1f}"
    })

sensitivity_df = pd.DataFrame(sensitivity_data)
print(sensitivity_df.to_string(index=False))

# まとめレポート
print(f"\n" + "="*80)
print("投資判断サマリー - ビル・ゲイツ氏向け主要指標")
print("="*80)


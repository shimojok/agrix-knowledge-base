from dataclasses import dataclass
from typing import List, Literal


Sex = Literal["male", "female", "other"]
FiberLevel = Literal["low", "medium", "high"]
FermentedFreq = Literal["rare", "sometimes", "daily"]
StressLevel = Literal["low", "medium", "high"]
ColdSensitivity = Literal["low", "medium", "high"]
EstrogenStatus = Literal["unknown", "normal", "low", "high"]
MenstrualStatus = Literal["premenopause", "perimenopause", "postmenopause", "none"]
Priority = Literal["low", "medium", "high"]


@dataclass
class Meta:
  record_id: str
  user_id: str
  timestamp: str
  version: str
  source: str


@dataclass
class UserContext:
  user_id: str
  sex: Sex
  age: int
  height_cm: float
  weight_kg: float


@dataclass
class Lifestyle:
  diet_pattern: str
  fiber_intake_level: FiberLevel
  fermented_food_frequency: FermentedFreq
  processed_food_score: int
  bowel_movement_frequency_per_day: float
  physical_activity_level: Literal["low", "medium", "high"]
  sleep_quality_score: int


@dataclass
class MBT55CompositionItem:
  group_id: str
  name: str
  relative_abundance: float
  beta_glucuronidase_activity: Literal["low", "medium", "high"]
  anti_inflammatory_potential: Literal["low", "medium", "high"]
  estrogen_metabolism_role: Literal["none", "support", "core"]


@dataclass
class Microbiome:
  scfa_production_score: int
  mbt55_composition: List[MBT55CompositionItem]


@dataclass
class Hormones:
  estrogen_status: EstrogenStatus
  menstrual_status: MenstrualStatus
  hormone_therapy: bool
  hormone_therapy_type: str


@dataclass
class MedicationAndStress:
  antihypertensive_use: bool
  magnesium_depleting_drugs: bool
  chronic_stress_level: StressLevel
  cold_sensitivity: ColdSensitivity


@dataclass
class PainProfile:
  thumb_cm_joint_pain_score: int
  other_chronic_pain_score: int


@dataclass
class Recommendation:
  code: str
  title: str
  description: str
  priority: Priority


@dataclass
class EstrobolomeMI:
  estrobolome_activity_score: int
  estrogen_recycling_efficiency: int
  mitochondrial_estrogen_response_score: int
  pain_correlation_score: int
  risk_flags: List[str]
  recommendations: List[Recommendation]


@dataclass
class AcetylCoAMI:
  acetyl_coa_availability_index: int
  glucose_contribution_score: int
  lipid_contribution_score: int
  amino_acid_contribution_score: int
  scfa_contribution_score: int
  mitochondrial_atp_capacity_score: int
  tca_cycle_efficiency_score: int
  metabolic_stress_index: int
  flags: List[str]
  recommendations: List[Recommendation]


@dataclass
class MBT55GroupFunctions:
  estrogen_metabolism: Literal["none", "support", "core"]
  scfa_production: Literal["low", "medium", "high"]
  anti_inflammatory: Literal["low", "medium", "high"]
  cofactor_generation: Literal["low", "medium", "high"]


@dataclass
class MBT55Group:
  group_id: str
  name: str
  functions: MBT55GroupFunctions


@dataclass
class MBT55Mapping:
  mbt55_groups: List[MBT55Group]
  overall_estrobolome_support_score: int
  overall_anti_inflammatory_score: int
  overall_metabolic_support_score: int


@dataclass
class Summary:
  metabolic_age: int
  inflammation_level: int
  pain_metabolic_correlation_score: int

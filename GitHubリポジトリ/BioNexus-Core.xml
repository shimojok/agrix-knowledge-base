.rp-section{margin-bottom:22px}
.rp-title{font-size:10px;font-weight:600;color:var(--text3);font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.09em;margin-bottom:8px;padding-bottom:5px;border-bottom:1px solid var(--border)}
.mb-row{display:flex;align-items:center;gap:7px;margin-bottom:7px}
.mb-label{font-size:10px;color:var(--text2);width:84px;flex-shrink:0}
.mb-track{flex:1;height:5px;background:var(--bg3);border-radius:3px;overflow:hidden}

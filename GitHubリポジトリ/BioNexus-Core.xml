/* IMPACT CARDS */
.ic-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:18px}
.ic{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:12px;position:relative;overflow:hidden}
.ic::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;opacity:.7}
.ic.food::after{background:var(--green)}.ic.health::after{background:var(--blue)}.ic.ghg::after{background:var(--teal)}.ic.fin::after{background:var(--amber)}
.ic .icl{font-size:9px;color:var(--text3);font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.07em;margin-bottom:5px}
.ic .icv{font-size:20px;font-weight:700;font-family:'JetBrains Mono',monospace;line-height:1;margin-bottom:2px}
.ic.food .icv{color:var(--green)}.ic.health .icv{color:var(--blue)}.ic.ghg .icv{color:var(--teal)}.ic.fin .icv{color:var(--amber)}
.ic .ics{font-size:10px;color:var(--text2)}
.ic .icd{position:absolute;top:10px;right:10px;font-size:9px;font-weight:600;font-family:'JetBrains Mono',monospace;color:var(--green)}

/* CANVAS */
.cw{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:6px;margin-bottom:18px}
canvas{display:block;width:100%}

/* MSC FLOW */
.msc-flow{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:16px 18px;margin-bottom:18px}
.msc-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:0;align-items:center;margin-top:12px}
.mn{background:var(--bg3);border:1px solid var(--border2);border-radius:7px;padding:10px 8px;text-align:center}
.mn .mni{font-size:18px;margin-bottom:3px}
.mn .mnt{font-size:10px;font-weight:600;color:var(--text);margin-bottom:2px}
.mn .mns{font-size:9px;color:var(--text3);font-family:'JetBrains Mono',monospace}

"""
MBT55微生物群集による炭素循環モデル
Wilkinsonの地球生態学理論に基づく炭素流動シミュレーション
"""

import numpy as np
from dataclasses import dataclass
from typing import Dict, List, Tuple, Optional
from enum import Enum

export interface SOCInput {
  // Module1/2から受け取るデータ
  soilData: SoilSensorInput;
  hypercycle: HypercycleOutput;
  humus: HumusOutput;
  
  // 計測設定
  measurementConfig: {
    baselineSOC: number;          // ベースラインSOC（%）
    measurementDepth_cm: number;  // 計測深度（cm）
    measurementMethod: 'LAB' | 'SPECTROSCOPY' | 'ESTIMATED';
  };
  
  // 歴史データ（あれば）
  historicalSOC?: { year: number; soc: number }[];
}

export interface SOCOutput {
  // 現在値
  current: {
    soc_percent: number;          // SOC（%）
    soc_tPerHa: number;           // SOC（t/ha）
    socTonnesPerHa: number;       // 同義（互換性用）
    bulkDensity: number;          // 仮比重（g/cm3）
    measurementDepth_cm: number;
  };
  
  // ベースライン
  baseline: {
    soc_percent: number;
    soc_tPerHa: number;
    year: number;                 // 基準年
  };
  
  // 予測（将来値）
  projection: {
    year1: { soc_percent: number; soc_tPerHa: number; };
    year5: { soc_percent: number; soc_tPerHa: number; };
    year10: { soc_percent: number; soc_tPerHa: number; };
    year20: { soc_percent: number; soc_tPerHa: number; };
  };
  
  // 増加トレンド
  trend: {
    annualIncrease_percent: number; // %/年

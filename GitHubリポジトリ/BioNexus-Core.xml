      <div class="contrib-item"><div class="ci-val" style="color:var(--blue)">−40%</div><div class="ci-label">病害による廃棄</div></div>
      <div class="contrib-item"><div class="ci-val" style="color:var(--amber)">+25%</div><div class="ci-label">収量安定化</div></div>
      <div class="contrib-item"><div class="ci-val" style="color:var(--teal)">−60%</div><div class="ci-label">殺処分ロス</div></div>

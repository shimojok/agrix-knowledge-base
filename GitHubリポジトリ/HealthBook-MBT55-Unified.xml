]

MENU_ITEMS_EN = [
    ("🏠 Home", PAGE_HOME, "Welcome"),
    ("📋 Health Assessment", PAGE_ASSESS, "200-item questionnaire to PATH_01-05"),
    ("🧬 Metabolic Analysis", PAGE_METABOLIC, "Herb & polyphenol pathways"),

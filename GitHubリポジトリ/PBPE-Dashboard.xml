        carbon_data = pd.DataFrame({
            'date': dates,
            'sequestration': np.cumsum(np.random.normal(40000, 10000, 90))
        })
        st.line_chart(carbon_data.set_index('date'))
    
    # Key metrics
    st.markdown("---")
    st.subheader("📊 Key Performance Indicators")
    
    col1, col2, col3, col4 = st.columns(4)
    with col1:
        st.metric("Farm ROI", "17.8x", "+23%")
    with col2:
        st.metric("Carbon Sequestration Rate", "2.5 tCO₂e/ha/Y", "+233%")
    with col3:
        st.metric("Rust Suppression Rate", "85%", "+35%")
    with col4:
        st.metric("Chemical Fertilizer Reduction", "40%", "-140 kg/ha")

# ==================== Carbon Ledger ====================
elif tab == "🌱 Carbon Ledger":
    st.markdown('<h1 class="main-header">🌱 Carbon Ledger</h1>', unsafe_allow_html=True)
    
    # Period selection
    time_range = st.selectbox("Period", ["7 Days", "30 Days", "90 Days", "1 Year"], index=1)
    days = {"7 Days": 7, "30 Days": 30, "90 Days": 90, "1 Year": 365}[time_range]
    
    # Generate carbon sequestration data
    dates = pd.date_range(end=datetime.now(), periods=days, freq='D')
    carbon_data = pd.DataFrame({
        'date': dates,
        'Daily Sequestration (tCO₂e)': np.random.normal(40000, 10000, days),
        'Cumulative (tCO₂e)': np.cumsum(np.random.normal(40000, 10000, days))
    })
    
    col1, col2 = st.columns(2)
    with col1:
        st.subheader("Daily Carbon Sequestration")
        st.line_chart(carbon_data.set_index('date')['Daily Sequestration (tCO₂e)'])
    with col2:
        st.subheader("Cumulative Carbon Storage")
        st.area_chart(carbon_data.set_index('date')['Cumulative (tCO₂e)'])
    
    # Farm data
    st.subheader("🌍 Carbon Credits by Farm")
    farm_data = pd.DataFrame({
        'Farm': ['Sidama Estate', 'Finca Paraiso', 'Fazenda Izabel', 'Hacienda Minita', 'Karatu Farm'],
        'Country': ['Ethiopia', 'Colombia', 'Brazil', 'Costa Rica', 'Kenya'],
        'Area (ha)': [250, 180, 500, 120, 90],
        'Credits (tCO₂e)': [625, 450, 1250, 360, 225],
        'Revenue ($)': [50000, 36000, 100000, 28800, 18000]
    })
    st.dataframe(farm_data, use_container_width=True)
    st.bar_chart(farm_data.set_index('Farm')['Credits (tCO₂e)'])

# ==================== Impact Simulator ====================
elif tab == "📈 Impact Simulator":
    st.markdown('<h1 class="main-header">📈 Impact Simulator</h1>', unsafe_allow_html=True)
    
    col1, col2, col3 = st.columns(3)
    with col1:
        area_ha = st.number_input("Farm Area (ha)", min_value=1, max_value=1000, value=10)
    with col2:
        coffee_price = st.number_input("Coffee Price ($/kg)", min_value=1.0, max_value=10.0, value=3.50, step=0.10)
    with col3:
        carbon_price = st.number_input("Carbon Price ($/tCO₂e)", min_value=10, max_value=200, value=80, step=5)
    
    mbtt55 = st.checkbox("🌱 Apply MBT55/HMT238", value=True)
    
    # Calculate
    if mbtt55:
        yield_val = 1200 * 1.35 * area_ha
        carbon_seq = 2.5 * area_ha
        revenue = yield_val * coffee_price + carbon_seq * carbon_price * 0.85
        cost = 235 * area_ha
        profit = revenue - cost
        roi = profit / cost
    else:
        yield_val = 1200 * area_ha
        carbon_seq = 0.75 * area_ha
        revenue = yield_val * coffee_price
        cost = 350 * area_ha
        profit = revenue - cost
        roi = profit / cost if cost > 0 else 0
    
    col1, col2, col3, col4 = st.columns(4)
    with col1:
        st.metric("Yield", f"{yield_val:,.0f} kg", f"+{35 if mbtt55 else 0}%")
    with col2:
        st.metric("Carbon Seq.", f"{carbon_seq:,.1f} tCO₂e", f"+{233 if mbtt55 else 0}%")
    with col3:
        st.metric("Revenue", f"${revenue:,.0f}", f"+{110 if mbtt55 else 0}%")
    with col4:
        st.metric("ROI", f"{roi:.1f}x", f"{'✅' if roi > 10 else '❌'}")
    
    # Comparison chart
    st.subheader("Baseline vs MBT55 Comparison")
    comparison = pd.DataFrame({
        'Metric': ['Yield (kg/ha)', 'Revenue ($/ha)', 'Carbon (tCO₂e/ha)', 'Profit ($/ha)'],
        'Baseline': [1200, 4200, 0.75, 1850],
        'MBT55': [1620, 5670, 2.5, 3892]
    })
    st.bar_chart(comparison.set_index('Metric'))

# ==================== Yield Predictor ====================
elif tab == "🌾 Yield Predictor":
    st.markdown('<h1 class="main-header">🌾 Yield Predictor</h1>', unsafe_allow_html=True)
    
    col1, col2 = st.columns(2)
    with col1:
        farm_select = st.selectbox("Select Farm", ["Sidama Estate (Ethiopia)", "Finca Paraiso (Colombia)", "Fazenda Izabel (Brazil)"])
    with col2:
        months = st.slider("Forecast Period (months)", 1, 12, 6)
    
    # Forecast data
    months_labels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
    current_month = datetime.now().month
    pred_months = months_labels[current_month-1:] + months_labels[:current_month-1]
    pred_months = pred_months[:months]
    
    base_yield = 1350 if "Sidama" in farm_select else 1280 if "Paraiso" in farm_select else 1420
    predictions = [base_yield * (1 + 0.02*i + np.random.normal(0, 0.03)) for i in range(months)]
    
    pred_df = pd.DataFrame({
        'Month': pred_months,
        'Predicted Yield (kg/ha)': predictions,
        'Upper Bound': [p * 1.08 for p in predictions],
        'Lower Bound': [p * 0.92 for p in predictions]
    })
    
    st.subheader("Yield Forecast (with Confidence Interval)")
    st.line_chart(pred_df.set_index('Month')[['Predicted Yield (kg/ha)', 'Upper Bound', 'Lower Bound']])
    
    # Disease risk
    st.subheader("🛡️ Disease Risk Assessment")
    rust_risk = pd.DataFrame({
        'Month': pred_months,
        'Rust Risk (%)': [max(0, min(100, 15 + 25*np.sin(i*0.8) + np.random.normal(0, 5))) for i in range(months)]
    })
    st.bar_chart(rust_risk.set_index('Month'))

# ==================== Finance Engine ====================
elif tab == "💰 Finance Engine":
    st.markdown('<h1 class="main-header">💰 Finance Engine</h1>', unsafe_allow_html=True)
    
    finance_tab = st.selectbox("Section", ["Bond List", "Portfolio", "Market Data"])
    
    if finance_tab == "Bond List":
        st.subheader("📋 Available Bonds & Tokens")
        bonds = pd.DataFrame({
            'Name': ['Sidama Regenerative Bond', 'Cerrado Climate Bond', 'Colombia Carbon Token', 'Ethiopia Yield Token'],
            'Type': ['Regenerative', 'Climate', 'Carbon-Linked', 'Yield-Linked'],
            'Face Value': ['$1,000', '$1,000', '$500', '$250'],
            'Coupon': ['6.0%', '5.5%', '7.0%', '8.0%'],
            'Maturity': ['10Y', '7Y', '5Y', '3Y'],
            'Yield': ['5.8%', '5.7%', '6.5%', '7.2%']
        })
        st.dataframe(bonds, use_container_width=True)
        
    elif finance_tab == "Portfolio":
        st.subheader("📊 Optimal Portfolio Allocation")
        portfolio = pd.DataFrame({
            'Asset': ['Regenerative Bonds', 'Carbon Tokens', 'Yield Tokens', 'Ecosystem Credits', 'Cash'],
            'Allocation (%)': [40, 30, 15, 10, 5],
            'Expected Return (%)': [7.0, 15.0, 18.0, 10.0, 2.0],
            'Risk (%)': [5.0, 25.0, 20.0, 15.0, 0.5]
        })
        st.dataframe(portfolio, use_container_width=True)
        
        col1, col2 = st.columns(2)
        with col1:
            st.bar_chart(portfolio.set_index('Asset')['Allocation (%)'])
        with col2:
            st.bar_chart(portfolio.set_index('Asset')[['Expected Return (%)', 'Risk (%)']])
        
    elif finance_tab == "Market Data":
        st.subheader("📈 Carbon Price Trend")
        market_dates = pd.date_range(end=datetime.now(), periods=180, freq='D')
        market_data = pd.DataFrame({
            'date': market_dates,
            'Carbon Price ($/tCO₂e)': 75 + np.cumsum(np.random.normal(0.1, 0.5, 180)),
            'Coffee Price ($/kg)': 3.2 + np.cumsum(np.random.normal(0.005, 0.05, 180))
        })
        st.line_chart(market_data.set_index('date'))

# ==================== Climate Impact ====================
elif tab == "🌡️ Climate Impact":
    st.markdown('<h1 class="main-header">🌡️ Climate Impact Analysis</h1>', unsafe_allow_html=True)
    
    st.markdown("""
    <div class="insight-box">
        <h3>💡 Key Insight</h3>
        <p>As climate change progresses, the relative advantage of PBPE agriculture expands.<br>
        Under the SSP5-8.5 scenario (+4.4°C), PBPE agriculture reaches <b>1.9×</b> the profitability of conventional farming.</p>
    </div>
    """, unsafe_allow_html=True)
    
    # Mitigation effect
    col1, col2 = st.columns(2)
    with col1:
        st.subheader("🌍 Annual Carbon Mitigation Effect")
        mitigation = pd.DataFrame({
            'Category': ['Soil Carbon', 'Biochar', 'N₂O Reduction', 'Avoided Deforestation', 'Transport Reduction'],
            'Amount (MtCO₂e/yr)': [12.5, 5.0, 3.0, 8.0, 1.5]
        })
        st.bar_chart(mitigation.set_index('Category'))
    
    with col2:
        st.subheader("🛡️ Climate Resilience Comparison")
        resilience = pd.DataFrame({
            'Stress': ['Heat', 'Drought', 'Heavy Rain', 'Pests'],
            'Conventional (%)': [25, 40, 35, 30],
            'PBPE (%)': [8, 15, 12, 5]
        })
        st.bar_chart(resilience.set_index('Stress'))

# Footer
st.markdown("---")
st.caption("© 2026 PBPE Initiative | Planetary Bio-Phenome Engine | Contact: info@terraviss.com")
</file>

<file path="azure/arm_templates/deployment.json">
{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "production",
      "allowedValues": ["development", "staging", "production"],
      "metadata": {
        "description": "Environment name"
      }
    },
    "cosmosDbAccountName": {
      "type": "string",
      "defaultValue": "[concat('pbpe-cosmos-', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Cosmos DB account name"
      }
    },
    "functionAppName": {
      "type": "string",
      "defaultValue": "[concat('pbpe-func-', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Function App name"
      }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "[concat('pbpe-kv-', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Key Vault name"
      }
    },
    "confidentialLedgerName": {
      "type": "string",
      "defaultValue": "[concat('pbpe-ledger-', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Confidential Ledger name"
      }
    }
  },
  "variables": {
    "storageAccountName": "[concat('pbpestorage', uniqueString(resourceGroup().id))]",
    "appServicePlanName": "[concat('pbpe-asp-', parameters('environmentName'))]",
    "iotHubName": "[concat('pbpe-iothub-', parameters('environmentName'))]",
    "digitalTwinsName": "[concat('pbpe-dt-', parameters('environmentName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2022-09-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-03-01",
      "name": "[variables('appServicePlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "S1",
        "tier": "Standard"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-03-01",
      "name": "[parameters('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "siteConfig": {
          "appSettings": [
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2022-09-01').keys[0].value)]"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "node"
            },
            {
              "name": "WEBSITE_NODE_DEFAULT_VERSION",
              "value": "~18"
            },
            {
              "name": "CosmosDBConnection",
              "value": "[listConnectionStrings(resourceId('Microsoft.DocumentDB/databaseAccounts', parameters('cosmosDbAccountName')), '2023-04-15').connectionStrings[0].connectionString]"
            },
            {
              "name": "KeyVaultUri",
              "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2022-07-01').vaultUri]"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts",
      "apiVersion": "2023-04-15",
      "name": "[parameters('cosmosDbAccountName')]",
      "location": "[parameters('location')]",
      "kind": "GlobalDocumentDB",
      "properties": {
        "databaseAccountOfferType": "Standard",
        "locations": [
          {
            "locationName": "[parameters('location')]",
            "failoverPriority": 0
          }
        ],
        "enableFreeTier": "[equals(parameters('environmentName'), 'development')]",
        "enableAnalyticalStorage": false
      }
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases",
      "apiVersion": "2023-04-15",
      "name": "[concat(parameters('cosmosDbAccountName'), '/PBPE')]",
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', parameters('cosmosDbAccountName'))]"
      ],
      "properties": {
        "resource": {
          "id": "PBPE"
        }
      }
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers",
      "apiVersion": "2023-04-15",
      "name": "[concat(parameters('cosmosDbAccountName'), '/PBPE/Verifications')]",
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases', parameters('cosmosDbAccountName'), 'PBPE')]"
      ],
      "properties": {
        "resource": {
          "id": "Verifications",
          "partitionKey": {
            "paths": ["/farmId"],
            "kind": "Hash"
          }
        }
      }
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers",
      "apiVersion": "2023-04-15",
      "name": "[concat(parameters('cosmosDbAccountName'), '/PBPE/FarmMetrics')]",
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases', parameters('cosmosDbAccountName'), 'PBPE')]"
      ],
      "properties": {
        "resource": {
          "id": "FarmMetrics",
          "partitionKey": {
            "paths": ["/farmId"],
            "kind": "Hash"
          }
        }
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2022-07-01",
      "name": "[parameters('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableSoftDelete": true,
        "enablePurgeProtection": "[equals(parameters('environmentName'), 'production')]"
      }
    },
    {
      "type": "Microsoft.ConfidentialLedger/ledgers",
      "apiVersion": "2022-05-13",
      "name": "[parameters('confidentialLedgerName')]",
      "location": "[parameters('location')]",
      "properties": {
        "ledgerType": "Public",
        "aadBasedSecurityPrincipals": [
          {
            "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2022-03-01', 'Full').identity.principalId]",
            "tenantId": "[subscription().tenantId]",
            "ledgerRoleName": "Contributor"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Devices/IotHubs",
      "apiVersion": "2023-06-30",
      "name": "[variables('iotHubName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "S1",
        "tier": "Standard",
        "capacity": 1
      },
      "properties": {
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.DigitalTwins/digitalTwinsInstances",
      "apiVersion": "2023-01-31",
      "name": "[variables('digitalTwinsName')]",
      "location": "[parameters('location')]",
      "properties": {},
      "identity": {
        "type": "SystemAssigned"
      }
    }
  ],
  "outputs": {
    "functionAppUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2022-03-01').defaultHostName)]"
    },
    "cosmosDbEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DocumentDB/databaseAccounts', parameters('cosmosDbAccountName')), '2023-04-15').documentEndpoint]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2022-07-01').vaultUri]"
    },
    "confidentialLedgerEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ConfidentialLedger/ledgers', parameters('confidentialLedgerName')), '2022-05-13').ledgerUri]"
    }
  }
}
</file>

<file path="azure/digital_twins/FarmDigitalTwin.json">
{
  "@id": "dtmi:com:pbpe:Farm;1",
  "@type": "Interface",
  "@context": "dtmi:dtdl:context;2",
  "displayName": "PBPE Farm Digital Twin",
  "description": "Digital twin model for PBPE-enabled coffee farm",
  "contents": [
    {
      "@type": "Property",
      "name": "farmId",
      "schema": "string",
      "description": "Unique farm identifier"
    },
    {
      "@type": "Property",
      "name": "farmName",
      "schema": "string",
      "description": "Farm name"
    },
    {
      "@type": "Property",
      "name": "location",
      "schema": {
        "@type": "Object",
        "fields": [
          {
            "name": "latitude",
            "schema": "double"
          },
          {
            "name": "longitude",
            "schema": "double"
          },
          {
            "name": "elevation",
            "schema": "double"
          }
        ]
      },
      "description": "Geographic location"
    },
    {
      "@type": "Property",
      "name": "areaHectares",
      "schema": "double",
      "description": "Total farm area in hectares"
    },
    {
      "@type": "Property",
      "name": "coffeeVariety",
      "schema": "string",
      "description": "Coffee variety planted"
    },
    {
      "@type": "Property",
      "name": "plantingYear",
      "schema": "integer",
      "description": "Year of planting"
    },
    {
      "@type": "Property",
      "name": "treeDensity",
      "schema": "integer",
      "description": "Trees per hectare"
    },
    {
      "@type": "Property",
      "name": "mbtt55Applied",
      "schema": "boolean",
      "description": "Whether MBT55 has been applied"
    },
    {
      "@type": "Property",
      "name": "mbtt55ApplicationDate",
      "schema": "dateTime",
      "description": "Date of MBT55 application"
    },
    {
      "@type": "Property",
      "name": "certificationLevel",
      "schema": {
        "@type": "Enum",
        "enumValues": [
          {
            "name": "Bronze",
            "enumValue": 1
          },
          {
            "name": "Silver",
            "enumValue": 2
          },
          {
            "name": "Gold",
            "enumValue": 3
          },
          {
            "name": "Platinum",
            "enumValue": 4
          }
        ]
      },
      "description": "PBPE certification level"
    },
    {
      "@type": "Telemetry",
      "name": "soilMoisture",
      "schema": "double",
      "unit": "percent",
      "description": "Soil moisture percentage"
    },
    {
      "@type": "Telemetry",
      "name": "soilTemperature",
      "schema": "double",
      "unit": "celsius",
      "description": "Soil temperature"
    },
    {
      "@type": "Telemetry",
      "name": "soilPH",
      "schema": "double",
      "description": "Soil pH level"
    },
    {
      "@type": "Telemetry",
      "name": "soilOrganicCarbon",
      "schema": "double",
      "unit": "percent",
      "description": "Soil organic carbon percentage"
    },
    {
      "@type": "Telemetry",
      "name": "carbonSequestrationRate",
      "schema": "double",
      "unit": "tonneCO2ePerHectarePerYear",
      "description": "Carbon sequestration rate"
    },
    {
      "@type": "Telemetry",
      "name": "rustIncidence",
      "schema": "double",
      "unit": "percent",
      "description": "Coffee leaf rust incidence rate"
    },
    {
      "@type": "Telemetry",
      "name": "yieldProjection",
      "schema": "double",
      "unit": "kilogramPerHectare",
      "description": "Projected yield"
    },
    {
      "@type": "Telemetry",
      "name": "ndviIndex",
      "schema": "double",
      "description": "Normalized Difference Vegetation Index"
    },
    {
      "@type": "Command",
      "name": "requestCarbonVerification",
      "description": "Request carbon sequestration verification",
      "request": {
        "name": "verificationPeriod",
        "schema": "string"
      },
      "response": {
        "name": "verificationResult",
        "schema": {
          "@type": "Object",
          "fields": [
            {
              "name": "verificationHash",
              "schema": "string"
            },
            {
              "name": "carbonSequestered",
              "schema": "double"
            },
            {
              "name": "status",
              "schema": "string"
            }
          ]
        }
      }
    },
    {
      "@type": "Command",
      "name": "mintPBPECredit",
      "description": "Mint PBPE carbon credit",
      "request": {
        "name": "creditAmount",
        "schema": "double"
      },
      "response": {
        "name": "mintingResult",
        "schema": {
          "@type": "Object",
          "fields": [
            {
              "name": "creditId",
              "schema": "string"
            },
            {
              "name": "transactionHash",
              "schema": "string"
            }
          ]
        }
      }
    },
    {
      "@type": "Relationship",
      "name": "contains",

<script>
// ── TAB SWITCHING ──
function switchTab(name) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.getElementById('page-' + name).classList.add('active');
  const tabs = {overview:0,msc:1,finance:2,impact:3};
  document.querySelectorAll('.tab')[tabs[name]].classList.add('active');
  if (name === 'msc') initCycleCanvas();
  if (name === 'impact') initPriceCanvas();
}

// ── EXPORT MODAL ──
function openExport() { document.getElementById('export-modal').classList.add('open'); }
function closeExport() { document.getElementById('export-modal').classList.remove('open'); document.getElementById('pitch-section').style.display='none'; }
function showPitch() { document.getElementById('pitch-section').style.display='block'; }
function copyURL() { navigator.clipboard.writeText(location.href).then(()=>{setStatus('✓ URL copied to clipboard');}); }
function setStatus(msg) { document.getElementById('export-status').textContent = msg; }

function exportPNG() {
  setStatus('⏳ Generating screenshot...');
  const bar = document.getElementById('export-progress');
  const fill = document.getElementById('export-fill');
  bar.style.display = 'block'; fill.style.width = '30%';
  const target = document.querySelector('.page.active');
  html2canvas(target, {backgroundColor:'#0D1117', scale:2, useCORS:true}).then(canvas => {
    fill.style.width = '100%';
    setTimeout(() => {
      const a = document.createElement('a');
      a.download = 'PBPE-Dashboard-EN.png';
      a.href = canvas.toDataURL('image/png');
      a.click();
      setStatus('✓ PNG export complete');
      bar.style.display = 'none';
    }, 400);
  }).catch(() => setStatus('⚠ html2canvas is loading. Please wait a moment and try again.'));
}

function exportHTML() {
  const blob = new Blob([document.documentElement.outerHTML], {type:'text/html'});
  const a = document.createElement('a');
  a.download = 'PBPE-Dashboard-v2-EN.html';
  a.href = URL.createObjectURL(blob);
  a.click();
  setStatus('✓ HTML download started');
}

// ── HYPERCYCLE CANVAS (Overview) ──
const cvH = document.getElementById('cv-hyper');
const ctxH = cvH.getContext('2d');
function resizeH() { const r = cvH.parentElement.getBoundingClientRect(); cvH.width = r.width - 16; cvH.height = 420; }
resizeH(); window.addEventListener('resize', resizeH);

const NODES = [
  {id:'msc',label:'MBT Sustainable\nCycle',sub:'ENGINE',x:.5,y:.5,r:52,color:'#F0A500',glow:'#F0A50040',isMSC:true},
  {id:'food',label:'Food Security',sub:'FOOD SECURITY',x:.5,y:.07,r:36,color:'#39D353',glow:'#39D35330'},
  {id:'nutri',label:'Nutrition',sub:'NUTRITION',x:.82,y:.2,r:36,color:'#58A6FF',glow:'#58A6FF30'},
  {id:'medical',label:'Healthcare\nCost',sub:'HEALTHCARE',x:.93,y:.55,r:36,color:'#BC8CFF',glow:'#BC8CFF30'},
  {id:'ghg',label:'GHG\nReduction',sub:'CLIMATE',x:.72,y:.88,r:36,color:'#3DCFCF',glow:'#3DCFCF30'},
  {id:'food_ent',label:'Food Biz\nRevenue',sub:'FOOD BIZ',x:.28,y:.88,r:36,color:'#C9A84C',glow:'#C9A84C30'},
  {id:'invest',label:'Investor\nReturns',sub:'INVESTORS',x:.07,y:.55,r:36,color:'#F85149',glow:'#F8514930'},
  {id:'insure',label:'Insurance\nFinance',sub:'RISK+FINANCE',x:.18,y:.2,r:36,color:'#FF9F43',glow:'#FF9F4330'},
];
const EDGES = NODES.slice(1).map((n,i)=>({from:'msc',to:n.id,color:n.color,phase:(i/6)*Math.PI*2}));

function gp(n){return{x:n.x*cvH.width,y:n.y*cvH.height};}
function drawGlowH(x,y,r,c){const g=ctxH.createRadialGradient(x,y,r*.3,x,y,r*2.2);g.addColorStop(0,c);g.addColorStop(1,'transparent');ctxH.beginPath();ctxH.arc(x,y,r*2.2,0,Math.PI*2);ctxH.fillStyle=g;ctxH.fill();}
function drawPulseH(f,t2,c,ph,tm){
  ctxH.beginPath();ctxH.moveTo(f.x,f.y);ctxH.lineTo(t2.x,t2.y);ctxH.strokeStyle=c+'25';ctxH.lineWidth=1.5;ctxH.stroke();
  const p=((tm*.0007+ph)%1+1)%1;const px=f.x+(t2.x-f.x)*p;const py=f.y+(t2.y-f.y)*p;
  const bg=ctxH.createRadialGradient(px,py,0,px,py,8);bg.addColorStop(0,c+'FF');bg.addColorStop(.5,c+'80');bg.addColorStop(1,'transparent');
  ctxH.beginPath();ctxH.arc(px,py,8,0,Math.PI*2);ctxH.fillStyle=bg;ctxH.fill();
  ctxH.beginPath();ctxH.arc(px,py,3,0,Math.PI*2);ctxH.fillStyle=c;ctxH.fill();
}
function drawNodeH(n,p,tm){
  const{r,color,glow,isMSC}=n;const{x,y}=p;
  drawGlowH(x,y,r,glow);
  if(isMSC){const pulse=1+Math.sin(tm*.002)*.08;ctxH.beginPath();ctxH.arc(x,y,r*pulse+8,0,Math.PI*2);ctxH.strokeStyle=color+'40';ctxH.lineWidth=2;ctxH.stroke();ctxH.beginPath();ctxH.arc(x,y,r*pulse+16,0,Math.PI*2);ctxH.strokeStyle=color+'18';ctxH.lineWidth=1.5;ctxH.stroke();}
  const gr=ctxH.createRadialGradient(x-r*.2,y-r*.2,r*.1,x,y,r);
  if(isMSC){gr.addColorStop(0,'#3A2A00');gr.addColorStop(1,'#1A1000');}else{gr.addColorStop(0,'#21262D');gr.addColorStop(1,'#161B22');}
  ctxH.beginPath();ctxH.arc(x,y,r,0,Math.PI*2);ctxH.fillStyle=gr;ctxH.fill();ctxH.strokeStyle=color+(isMSC?'CC':'80');ctxH.lineWidth=isMSC?2:1.5;ctxH.stroke();
  ctxH.textAlign='center';ctxH.textBaseline='middle';
  if(isMSC){ctxH.font='700 12px "JetBrains Mono",monospace';ctxH.fillStyle=color;n.label.split('\n').forEach((l,i,a)=>ctxH.fillText(l,x,y+(i-(a.length-1)/2)*15));ctxH.font='500 9px "JetBrains Mono",monospace';ctxH.fillStyle=color+'80';ctxH.fillText(n.sub,x,y+26);}
  else{ctxH.font='600 11px Inter,sans-serif';ctxH.fillStyle='#E6EDF3';const ls=n.label.split('\n');ls.forEach((l,i)=>ctxH.fillText(l,x,y+(i-(ls.length-1)/2)*14-5));ctxH.font='400 9px "JetBrains Mono",monospace';ctxH.fillStyle=color+'AA';ctxH.fillText(n.sub,x,y+ls.length*7+2);}
}
let htm=0;
function drawH(ts){htm=ts;ctxH.clearRect(0,0,cvH.width,cvH.height);
  ctxH.fillStyle='#30363D18';for(let gx=20;gx<cvH.width;gx+=40)for(let gy=20;gy<cvH.height;gy+=40){ctxH.beginPath();ctxH.arc(gx,gy,1,0,Math.PI*2);ctxH.fill();}
  const pos={};NODES.forEach(n=>{pos[n.id]=gp(n);});
  EDGES.forEach(e=>drawPulseH(pos[e.from],pos[e.to],e.color,e.phase,ts));
  NODES.forEach(n=>drawNodeH(n,pos[n.id],ts));
  requestAnimationFrame(drawH);
}
requestAnimationFrame(drawH);

// ── MSC CYCLE CANVAS ──
const cvC = document.getElementById('cv-cycle');
const ctxC = cvC.getContext('2d');
let cycleInited = false;
function initCycleCanvas(){
  if(cycleInited) return; cycleInited=true;
  const r=cvC.parentElement.getBoundingClientRect(); cvC.width=r.width-16; cvC.height=340;
  drawCycle(performance.now());
}
const CYCLE_NODES=[
  {label:'Organic Waste',sub:'INPUT',angle:-90,color:'#8B949E'},
  {label:'MBT55 Ferment\n24h',sub:'ENGINE',angle:-18,color:'#F0A500',big:true},
  {label:'Fermented\nFert./Feed',sub:'OUTPUT',angle:54,color:'#39D353'},
  {label:'MBT Crops\nPremium Quality',sub:'PRODUCT',angle:126,color:'#3DCFCF'},
  {label:'Carbon Seq.\nGHG Reduction',sub:'CREDIT',angle:198,color:'#58A6FF'},
];
function drawCycle(ts){
  ctxC.clearRect(0,0,cvC.width,cvC.height);
  const cx=cvC.width/2, cy=cvC.height/2, RR=Math.min(cx,cy)*0.62;
  ctxC.fillStyle='#30363D18';for(let gx=20;gx<cvC.width;gx+=40)for(let gy=20;gy<cvC.height;gy+=40){ctxC.beginPath();ctxC.arc(gx,gy,1,0,Math.PI*2);ctxC.fill();}
  // orbit ring
  ctxC.beginPath();ctxC.arc(cx,cy,RR,0,Math.PI*2);ctxC.strokeStyle='#30363D';ctxC.lineWidth=1;ctxC.stroke();
  // animated arc
  const arc=((ts*.0003)%(Math.PI*2));
  ctxC.beginPath();ctxC.arc(cx,cy,RR,arc,arc+Math.PI*1.5);ctxC.strokeStyle='#F0A50040';ctxC.lineWidth=3;ctxC.stroke();
  // nodes
  CYCLE_NODES.forEach(n=>{
    const ang=n.angle*Math.PI/180;
    const nx=cx+Math.cos(ang)*RR, ny=cy+Math.sin(ang)*RR;
    const r=n.big?46:38;
    const gl=ctxC.createRadialGradient(nx,ny,r*.3,nx,ny,r*2);gl.addColorStop(0,n.color+'30');gl.addColorStop(1,'transparent');
    ctxC.beginPath();ctxC.arc(nx,ny,r*2,0,Math.PI*2);ctxC.fillStyle=gl;ctxC.fill();
    ctxC.beginPath();ctxC.arc(nx,ny,r,0,Math.PI*2);ctxC.fillStyle=n.big?'#2A1A00':'#161B22';ctxC.fill();ctxC.strokeStyle=n.color+(n.big?'CC':'80');ctxC.lineWidth=n.big?2:1.5;ctxC.stroke();
    ctxC.textAlign='center';ctxC.textBaseline='middle';
    ctxC.font=(n.big?'700':'600')+' 11px Inter,sans-serif';ctxC.fillStyle='#E6EDF3';
    const ls=n.label.split('\n');ls.forEach((l,i)=>ctxC.fillText(l,nx,ny+(i-(ls.length-1)/2)*13-3));
    ctxC.font='400 9px "JetBrains Mono",monospace';ctxC.fillStyle=n.color+'AA';ctxC.fillText(n.sub,nx,ny+ls.length*7+2);
  });
  // center label
  ctxC.textAlign='center';ctxC.textBaseline='middle';ctxC.font='700 13px "JetBrains Mono",monospace';ctxC.fillStyle='#F0A500';ctxC.fillText('MBT',cx,cy-8);ctxC.fillText('Sustainable',cx,cy+6);ctxC.fillText('Cycle',cx,cy+20);
  requestAnimationFrame(drawCycle);
}

// ── PRICE SIMULATION CANVAS ──
const cvP = document.getElementById('cv-price');
const ctxP = cvP.getContext('2d');
let priceInited = false;
function initPriceCanvas(){
  if(priceInited) return; priceInited=true;
  const r=cvP.parentElement.getBoundingClientRect(); cvP.width=r.width-16; cvP.height=260;
  drawPrice();
}
function drawPrice(){
  ctxP.clearRect(0,0,cvP.width,cvP.height);
  const W=cvP.width, H=cvP.height;
  const pad={t:20,r:20,b:40,l:50};
  const iW=W-pad.l-pad.r, iH=H-pad.t-pad.b;
  const years=[2000,2005,2010,2015,2020,2024,2028,2032];
  const baseline=[100,120,160,145,175,227,260,290];
  const pbpe10= [100,120,160,145,175,210,225,235];
  const pbpe30= [100,120,160,145,175,200,195,180];
  const pbpe60= [100,120,160,145,175,185,165,145];
  const maxY=320, minY=80;
  function px(i){return pad.l+i/(years.length-1)*iW;}
  function py(v){return pad.t+iH-(v-minY)/(maxY-minY)*iH;}
  // grid
  ctxP.strokeStyle='#30363D';ctxP.lineWidth=1;
  [100,150,200,250,300].forEach(v=>{
    ctxP.beginPath();ctxP.moveTo(pad.l,py(v));ctxP.lineTo(W-pad.r,py(v));ctxP.stroke();
    ctxP.fillStyle='#6E7681';ctxP.font='10px "JetBrains Mono",monospace';ctxP.textAlign='right';ctxP.fillText(v,pad.l-6,py(v)+4);
  });
  years.forEach((y,i)=>{ctxP.fillStyle='#6E7681';ctxP.font='10px "JetBrains Mono",monospace';ctxP.textAlign='center';ctxP.fillText(y,px(i),H-8);});
  // lines
  function drawLine(data,color,dash=[]){
    ctxP.beginPath();ctxP.setLineDash(dash);ctxP.strokeStyle=color;ctxP.lineWidth=2;
    data.forEach((v,i)=>i===0?ctxP.moveTo(px(i),py(v)):ctxP.lineTo(px(i),py(v)));ctxP.stroke();ctxP.setLineDash([]);
    // dots
    data.forEach((v,i)=>{ctxP.beginPath();ctxP.arc(px(i),py(v),3,0,Math.PI*2);ctxP.fillStyle=color;ctxP.fill();});
  }
  drawLine(baseline,'#F85149',[]);
  drawLine(pbpe10,'#F0A500',[4,3]);
  drawLine(pbpe30,'#39D353',[4,3]);
  drawLine(pbpe60,'#3DCFCF',[4,3]);
  // legend
  const leg=[{c:'#F85149',l:'Baseline Trend'},{c:'#F0A500',l:'PBPE 10%'},{c:'#39D353',l:'PBPE 30%'},{c:'#3DCFCF',l:'PBPE 60%'}];
  leg.forEach((l,i)=>{
    const lx=pad.l+i*110+10, ly=pad.t+10;
    ctxP.fillStyle=l.c;ctxP.fillRect(lx,ly,18,2);
    ctxP.beginPath();ctxP.arc(lx+9,ly+1,3,0,Math.PI*2);ctxP.fillStyle=l.c;ctxP.fill();
    ctxP.fillStyle='#8B949E';ctxP.font='10px Inter,sans-serif';ctxP.textAlign='left';ctxP.fillText(l.l,lx+22,ly+4);
  });
}
</script>
</body>

    expectedReturn: 0,
    portfolioRisk: 0,
    sharpeRatio: 0,
  });

  useEffect(() => {
    generateMockData();
  }, []);

  const generateMockData = () => {
    const mockBonds: BondData[] = [
      {
        id: 'RCB-2024-001',

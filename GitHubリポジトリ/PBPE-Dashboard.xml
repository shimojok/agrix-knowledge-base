      {
        id: 'RCB-2024-002',
        name: 'Cerrado Climate Bond',
        faceValue: 1000,
        couponRate: 5.5,
        maturity: 7,
        carbonTarget: 15000,
        issuedAmount: 3000000,
        price: 995,
        yield: 5.7,
      },
      {
        id: 'CLT-2024-001',
        name: 'Colombia Carbon-Linked Token',
        faceValue: 500,
        couponRate: 7.0,
        maturity: 5,
        carbonTarget: 8000,
        issuedAmount: 2000000,
        price: 515,
        yield: 6.5,

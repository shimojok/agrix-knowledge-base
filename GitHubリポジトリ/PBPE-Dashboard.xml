.fd-arrow span{position:absolute;top:-14px;left:50%;transform:translateX(-50%);font-size:9px;color:var(--text3);font-family:'JetBrains Mono',monospace;white-space:nowrap;}
.market-table{margin-bottom:18px;}
.mt-row{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid var(--border);background:var(--bg2);}
.mt-row:first-child{background:var(--bg3);border-radius:10px 10px 0 0;}
.mt-row:last-child{border-bottom:none;border-radius:0 0 10px 10px;}
.mt-row.hdr{font-size:10px;font-weight:700;color:var(--text3);font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.07em;}
.mt-market{width:180px;font-size:12px;font-weight:600;}
.mt-size{width:90px;font-size:12px;font-family:'JetBrains Mono',monospace;font-weight:700;}
.mt-bar{flex:1;}
.mt-pbpe{width:100px;font-size:11px;color:var(--green);}
.mt-bar-inner{height:6px;border-radius:3px;}

/* IMPACT PAGE */
.impact7-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:18px;}
.i7-card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:16px;}
.i7-head{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
.i7-num{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;font-family:'JetBrains Mono',monospace;flex-shrink:0;}
.i7-title{font-size:13px;font-weight:600;}
.i7-kpi{display:flex;gap:10px;margin-bottom:8px;}
.i7-kpi-item{flex:1;background:var(--bg3);border-radius:6px;padding:8px;text-align:center;}
.i7-kpi-val{font-size:16px;font-weight:700;font-family:'JetBrains Mono',monospace;margin-bottom:2px;}
.i7-kpi-lbl{font-size:9px;color:var(--text3);font-family:'JetBrains Mono',monospace;text-transform:uppercase;}
.i7-desc{font-size:11px;color:var(--text2);line-height:1.5;}
.price-sim{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:20px;margin-bottom:18px;}
.sim-canvas-wrap{background:var(--bg3);border-radius:8px;padding:8px;margin-top:14px;}

/* RIGHT PANEL */
.rpanel{border-left:1px solid var(--border);background:var(--bg2);padding:20px 16px;overflow:auto;}
.rp-sec{margin-bottom:22px;}
.rp-title{font-size:11px;font-weight:600;color:var(--text3);font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.09em;margin-bottom:10px;padding-bottom:6px;border-bottom:1px solid var(--border);}
.mini-bar-row{display:flex;align-items:center;gap:8px;margin-bottom:7px;}
.mb-lbl{font-size:11px;color:var(--text2);width:90px;flex-shrink:0;}
.mb-track{flex:1;height:6px;background:var(--bg3);border-radius:3px;overflow:hidden;}
.mb-fill{height:100%;border-radius:3px;}
.mb-val{font-size:10px;color:var(--text3);font-family:'JetBrains Mono',monospace;width:32px;text-align:right;}
.commit-list{display:flex;flex-direction:column;gap:6px;}
.commit-item{display:flex;gap:8px;align-items:flex-start;padding:8px;border-radius:6px;border:1px solid var(--border);background:var(--bg3);}
.c-dot{width:8px;height:8px;border-radius:50%;margin-top:3px;flex-shrink:0;}
.c-text{font-size:11px;color:var(--text);line-height:1.4;}
.c-meta{font-size:10px;color:var(--text3);margin-top:2px;font-family:'JetBrains Mono',monospace;}
.price-crisis{background:linear-gradient(135deg,#1A0A0A,#1A0F00);border:1px solid #5A1A1A;border-radius:8px;padding:14px;margin-bottom:10px;}
.pc-lbl{font-size:10px;color:var(--red);font-family:'JetBrains Mono',monospace;font-weight:700;text-transform:uppercase;letter-spacing:.07em;margin-bottom:5px;}
.pc-val{font-size:20px;font-weight:700;color:var(--text);font-family:'JetBrains Mono',monospace;}
.pc-sub{font-size:11px;color:var(--text2);margin-top:3px;}
.pc-pbpe{font-size:11px;color:var(--green);margin-top:8px;font-weight:500;}
.pc-pbpe::before{content:'→ ';}
.contrib-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;}
.ci{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:10px;text-align:center;}
.ci-val{font-size:16px;font-weight:700;font-family:'JetBrains Mono',monospace;}
.ci-lbl{font-size:10px;color:var(--text2);margin-top:2px;}

/* EXPORT MODAL */
.modal-bg{display:none;position:fixed;inset:0;background:#00000090;z-index:500;align-items:center;justify-content:center;}
.modal-bg.open{display:flex;}
.modal{background:var(--bg2);border:1px solid var(--border2);border-radius:12px;padding:28px;width:480px;max-width:90vw;}
.modal h2{font-size:16px;font-weight:700;font-family:'JetBrains Mono',monospace;color:var(--text);margin-bottom:6px;}
.modal p{font-size:12px;color:var(--text2);margin-bottom:20px;}
.modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px;}
.export-option{background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:16px;cursor:pointer;transition:all .15s;text-align:center;}
.export-option:hover{border-color:var(--border2);background:var(--bg);}
.export-option .eo-icon{font-size:28px;margin-bottom:6px;}
.export-option .eo-title{font-size:12px;font-weight:700;font-family:'JetBrains Mono',monospace;color:var(--text);margin-bottom:3px;}
.export-option .eo-sub{font-size:10px;color:var(--text3);}
.modal-close{background:var(--bg3);border:1px solid var(--border);color:var(--text2);font-size:12px;padding:7px 16px;border-radius:6px;cursor:pointer;font-family:'JetBrains Mono',monospace;}
.pitch-slides{margin-bottom:18px;}
.slide-item{background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:12px 14px;margin-bottom:6px;display:flex;align-items:center;gap:12px;cursor:pointer;transition:all .15s;}
.slide-item:hover{border-color:var(--border2);}
.slide-num{font-size:11px;font-family:'JetBrains Mono',monospace;color:var(--text3);width:24px;}
.slide-title{font-size:12px;font-weight:600;color:var(--text);}
.slide-sub{font-size:10px;color:var(--text2);margin-top:1px;}
.slide-tag{margin-left:auto;font-size:9px;font-weight:700;font-family:'JetBrains Mono',monospace;padding:2px 6px;border-radius:8px;}
.progress-bar{height:4px;background:var(--bg3);border-radius:2px;margin-top:8px;overflow:hidden;}
.progress-fill{height:100%;border-radius:2px;background:linear-gradient(90deg,var(--green),var(--amber));transition:width .5s;}
#export-status{font-size:11px;color:var(--text2);font-family:'JetBrains Mono',monospace;margin-top:6px;text-align:center;min-height:16px;}
</style>
</head>

<script>
const canvas=document.getElementById('bg'),ctx=canvas.getContext('2d');
function resize(){canvas.width=window.innerWidth;canvas.height=window.innerHeight;}
resize();window.addEventListener('resize',resize);
const OUTER=[
  {color:'#39D353',angle:-90},{color:'#58A6FF',angle:-18},
  {color:'#BC8CFF',angle:54},{color:'#3DCFCF',angle:126},
  {color:'#C9A84C',angle:198},{color:'#F85149',angle:270},
  {color:'#FF9F43',angle:342}
];
function draw(ts){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  const cx=canvas.width/2,cy=canvas.height/2,R=Math.min(cx,cy)*.52,rc=56,ro=35;
  ctx.fillStyle='#30363D18';
  for(let gx=0;gx<canvas.width;gx+=48)for(let gy=0;gy<canvas.height;gy+=48){ctx.beginPath();ctx.arc(gx,gy,1,0,Math.PI*2);ctx.fill();}
  ctx.beginPath();ctx.arc(cx,cy,R,0,Math.PI*2);ctx.strokeStyle='#30363D40';ctx.lineWidth=1;ctx.stroke();
  const ar=((ts*.0002)%(Math.PI*2));
  ctx.beginPath();ctx.arc(cx,cy,R,ar,ar+Math.PI*1.6);ctx.strokeStyle='#F0A50028';ctx.lineWidth=2;ctx.stroke();
  OUTER.forEach((n,i)=>{
    const ang=(n.angle+ts*.008)*Math.PI/180;
    const nx=cx+Math.cos(ang)*R,ny=cy+Math.sin(ang)*R;
    const ph=((ts*.0005+i/7)%1+1)%1;
    const px=cx+(nx-cx)*ph,py=cy+(ny-cy)*ph;
    const bg=ctx.createRadialGradient(px,py,0,px,py,9);
    bg.addColorStop(0,n.color+'BB');bg.addColorStop(.5,n.color+'35');bg.addColorStop(1,'transparent');
    ctx.beginPath();ctx.arc(px,py,9,0,Math.PI*2);ctx.fillStyle=bg;ctx.fill();
    ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(nx,ny);ctx.strokeStyle=n.color+'15';ctx.lineWidth=1.5;ctx.stroke();
    const gl=ctx.createRadialGradient(nx,ny,0,nx,ny,ro*2);
    gl.addColorStop(0,n.color+'18');gl.addColorStop(1,'transparent');
    ctx.beginPath();ctx.arc(nx,ny,ro*2,0,Math.PI*2);ctx.fillStyle=gl;ctx.fill();
    ctx.beginPath();ctx.arc(nx,ny,ro,0,Math.PI*2);ctx.fillStyle='#161B22BB';ctx.fill();
    ctx.strokeStyle=n.color+'55';ctx.lineWidth=1.5;ctx.stroke();
  });
  const pulse=1+Math.sin(ts*.002)*.07;
  [rc*pulse+16,rc*pulse+28].forEach((rr,i)=>{
    ctx.beginPath();ctx.arc(cx,cy,rr,0,Math.PI*2);ctx.strokeStyle='#F0A500'+(i===0?'28':'12');ctx.lineWidth=1.5;ctx.stroke();
  });
  const cg=ctx.createRadialGradient(cx-rc*.2,cy-rc*.2,rc*.1,cx,cy,rc);
  cg.addColorStop(0,'#2A1A00');cg.addColorStop(1,'#1A1000');
  ctx.beginPath();ctx.arc(cx,cy,rc*pulse,0,Math.PI*2);ctx.fillStyle=cg;ctx.fill();
  ctx.strokeStyle='#F0A500AA';ctx.lineWidth=2;ctx.stroke();
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>

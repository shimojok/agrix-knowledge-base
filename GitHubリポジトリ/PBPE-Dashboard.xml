<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PBPE · BioNexus Holdings</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap');
:root {
  --bg:#0D1117; --bg2:#161B22; --bg3:#21262D; --border:#30363D;
  --green:#39D353; --amber:#F0A500; --blue:#58A6FF; --teal:#3DCFCF;
  --text:#E6EDF3; --text2:#8B949E; --text3:#6E7681;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;position:relative;}
canvas#bg{position:fixed;inset:0;width:100%;height:100%;z-index:0;opacity:0.55;}
.content{position:relative;z-index:10;display:flex;flex-direction:column;align-items:center;padding:60px 24px 40px;text-align:center;max-width:680px;width:100%;}
.logo-wrap{display:flex;align-items:center;gap:10px;margin-bottom:12px;}
.logo-dot{width:10px;height:10px;background:var(--green);border-radius:50%;animation:pdot 2s infinite;flex-shrink:0;}
@keyframes pdot{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.5;transform:scale(1.4);}}
.logo-text{font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:var(--text2);letter-spacing:.14em;text-transform:uppercase;}
.title{font-family:'JetBrains Mono',monospace;font-size:clamp(26px,5vw,46px);font-weight:700;line-height:1.1;margin-bottom:6px;background:linear-gradient(135deg,var(--green) 0%,var(--amber) 50%,var(--blue) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:-.02em;}
.title-sub{font-family:'JetBrains Mono',monospace;font-size:clamp(10px,1.8vw,13px);font-weight:500;color:var(--text3);letter-spacing:.18em;text-transform:uppercase;margin-bottom:28px;}
.tagline{font-size:clamp(12px,1.8vw,14px);color:var(--text2);line-height:1.7;margin-bottom:32px;max-width:520px;}
.tagline b{color:var(--text);font-weight:600;}
.eq{display:inline-block;background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:2px 10px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--green);margin:0 2px;white-space:nowrap;}
.stats-row{display:flex;gap:20px;flex-wrap:wrap;justify-content:center;margin-bottom:28px;}
.stat{text-align:center;}
.stat-val{font-family:'JetBrains Mono',monospace;font-size:19px;font-weight:700;line-height:1;margin-bottom:3px;}
.stat-lbl{font-size:9px;color:var(--text3);font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.08em;}
.stat-div{width:1px;background:var(--border);align-self:stretch;}
.domain-pills{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-bottom:32px;}
.dp{font-size:10px;font-weight:600;font-family:'JetBrains Mono',monospace;padding:4px 10px;border-radius:20px;border:1px solid;animation:fadein .6s ease both;}
.dp:nth-child(1){color:var(--green);border-color:#196127;background:#39D35310;animation-delay:.1s}
.dp:nth-child(2){color:var(--blue);border-color:#1F4A8C;background:#58A6FF10;animation-delay:.2s}

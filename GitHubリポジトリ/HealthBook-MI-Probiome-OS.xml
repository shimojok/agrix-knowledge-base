// Snapshot v2
export type Snapshot = {
  responses: Record<string, number>;
  nutrition: {
    carb: number;
    fat: number;
    protein: number;
  };
  mbt55: {
    scfa: number;
    bile_acid: number;
  };
  estrobolome: {
    beta_glucuronidase: number;
  };
  mitochondria: {
    oxidative_stress: number;
  };
  lifestyle: {
    sleep_quality: number;
    stress: number;
  };
};

// Engine Results
export type EngineResults = {
  phenotype: {
    total_score: number;
    phenotype: string;
  };
  estrobolome: {
    estrobolome_score: number;
  };
  acetylcoa: {
    mi_acetylcoa_index: number;
  };
  inflammation: {
    inflammation_load: number;
  };
};

// Causal Map
export type CausalMap = {
  estrobolome_score_causal: number;
  acetylcoa_index_causal: number;
  atp_causal: number;
  inflammation_causal: number;
  disease_risk_causal: number;
};

// Disease Risk
export type DiseaseRisk = {
  diseases: Array<{
    disease_id: string;
    name: string;
    system: string;
    recommended_kampo: string[];
    contraindicated_kampo: string[];
  }>;
};

// Probiotics Screening
export type ProbioticsResult = {
  recommended_strains: string[];
  pathway_stage: string[];
  metabolites: string[];
};

// Kampo Recommendation
export type KampoRecommendation = {
  formula: any;
  herbs: any[];
};

// PBPE KPIs
export type PBPEKPI = {
  phenotype_score: number;
  estrobolome_score: number;
  acetylcoa_index: number;
  atp: number;
  inflammation: number;
  disease_risk: number;
};
